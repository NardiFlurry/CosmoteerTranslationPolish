		DirectControlLbl = "Direct Control Mode"
		OverlaysLbl = "Informational Overlays"
		MultiplayerLbl = "Multiplayer"
		CrewLbl = "Crew"

		AutoCollectNuggets = "Automatically Gather Resources"
		AutoCollectNuggetsTip = "If checked, then resources from salvaging ships and mining asteroids will be automatically gathered."

		OnShipIndicators = "Pokaż Ikony Statusu Statku"
		OnShipIndicatorsTip = "Jeśli zaznaczone, pokazywane będą ikony statusu statku takie jak: Brak Załogi, Brak Amunicji, Brak Mocy."

		SelectedPartStatusBars = "Show Status Bars For Selected Parts"
		SelectedPartStatusBarsTip = "If checked, health and status bars will be displayed for any selected parts."

		ShowSpaceCrewLines = "Show Flying Crew Lines"
		ShowSpaceCrewLinesTip = "If checked, dotted lines will be displayed connecting flying crew to their ships."

		ShowFavoriteCrewNamesOnHover = "Display Favorite Crew Names On Hover"
		ShowFavoriteCrewNamesOnHoverTip = "If checked, the names of crew marked 'favorite' will be displayed below them when hovered."

		LogFavoriteCrewDeaths = "Log Deaths of Favorite Crew"
		LogFavoriteCrewDeathsTip = "If checked, the deaths of favorite crew will be displayed in the message log."

		ShowResourcePickupLines = "Show Floating Resource Lines"
		ShowResourcePickupLinesTip = "If checked, dotted lines will be displayed connecting floating resources to their intended storages."

		NuggetsDots = "Show Floating Resource Dots"
		NuggetsDotsTip = "If enabled, the locations of previously-detected resources will be indicated with small dots."

		PauseOnOpenDialogueWithEnemy = "Pause On Dialogue With Enemy"
		PauseOnOpenDialogueWithEnemyTip = "If checked, the game will automatically pause when opening dialogue with an enemy ship."

		PauseWhenHailedByEnemy = "Pause When Hailed By Enemy"
		PauseWhenHailedByEnemyTip = "If checked, the game will automatically pause when an enemy ship hails you."

		OffScreenBlips = "Show Blips For Off-Screen Ships"
		OffScreenBlipsTip = "If checked, colored \"blips\" will be displayed for ships that are located past the edge of the screen."

		ZoomedOutBlips = "Show Blips When Zoomed Out"
		ZoomedOutBlipsTip = "If checked, colored \"blips\" will be displayed for small ships when zoomed out."

		BreadcrumbTrails = "Show Recent Flight Paths"
		BreadcrumbTrailsTip = "If checked, the recent flight paths of your ship(s) will be shown. This only affects Career Mode."

		PartToolTips = "Pokazuj Dodatkowe Informacje O Częściach"
		PartToolTipsTip = "Jeśli zaznaczone, zostanie pokazana dodatkowa informacja po przesunięciu kursora nad daną część statku."

		AllowShipDeselection = "Pozwalaj Na Odznaczenie Statku"
		AllowShipDeselectionTip = "Jeśli zaznaczone, kliknięcie na pustą przestrzeń spowoduje odznaczenie wyboru danego statku."

		ShowAdvancedCommands = "Show Advanced Ship Commands"
		ShowAdvancedCommandsTip = "If checked, advanced ship commands will be shown in the user interface. "\
		                          "Even if this is not checked, you can still use them by using their hotkeys."

		CtrlSelectsParts = "Wymagaj naciśnięcia <btn id='Game.SelectParts' xml='false'/> By Wybierać Części"
		CtrlSelectsPartsTip = "Jeśli zaznaczone, przycisk <btn id='Game.SelectParts'/> musi być trzymany podczas klikania na części by je wybrać."

		ShowNearbyMissions = "Show Nearby Missions On HUD"
		ShowNearbyMissionsTip = "Up to this many of the closest missions will be automatically displayed in the top-left corner of the HUD."

		ShowAllCommands = "Show Commands For All Ships"
		ShowAllCommandsTip = "If checked, command movement and attack paths will be shown for all ships under your control, not just the selected ships."

		AlwaysShowCommandWidgets = "Zawsze Pokazuj Uchwyty Dowodzenia"
		AlwaysShowCommandWidgetsTip = "Jeśli zaznaczone, nie musisz przytrzymywać klawisza <btn id='Game.AppendSelection'/> by wyświetlane były uchwyty dowodzenia."

		PreferWorldRelativeAttackAngle = "Prefer Grid-Relative Attack Angles"
		PreferWorldRelativeAttackAngleTip = "If checked, right-clicking and dragging on an enemy ship will use an attack angle relative to the background grid instead of the enemy ship. Hold <btn id='Game.WorldRelativeFollowAngle'/> to use the other mode."

		PreferWorldRelativeFollowAngle = "Preferuj Kąty Podążania Zależne Od Siatki Tła"
		PreferWorldRelativeFollowAngleTip = "Jeśli zaznaczone, kliknięcie prawym przyciskiem myszy i przeciągnięcie przyjaznego statku spowoduje użycie kątu podążania zależnego od tła zamiast kątu zależnego od przyjaznego statku. Przytrzymaj <btn id='Game.WorldRelativeFollowAngle'/> by użyć drugiego trybu."

		DirectControlAutoBrake = "Automatically Brake"
		DirectControlAutoBrakeTip = "If checked, then your ship will automatically brake to a stop when you are not holding any keys while in Direct Control Mode. Hold <btn id='Game.DirectControlBrake'/> to use the other mode."

		DirectControlEnableWeapons = "Enable Weapons Control"
		DirectControlEnableWeaponsTip = "If checked, then using Direct Control Mode will give you control of your ship's weapons. If not checked, your ship's weapons will be controlled by the A.I."

		DirectControlAimAssist = "Aim Assist"
		DirectControlAimAssistTip = "If checked, weapons will automatically aim at the enemy part closest to the mouse cursor."

		DirectControlAutoFaceCursor = "Face Ship Toward Cursor"
		DirectControlAutoFaceCursorTip = "If checked, then your ship will automatically rotate to face toward the mouse cursor while in Direct Control Mode. Press <btn id='Game.DirectControlToggleFaceCursor'/> to toggle while in Direct Control Mode."

		DirectControlShowWeaponCoverage = "Show Firing Arcs"
		DirectControlShowWeaponCoverageTip = "If checked, then weapon firing arcs will be shown while in Direct Control Mode."

		EnableCollisionAvoidance = "Enable Collision Avoidance"
		EnableCollisionAvoidanceTip = "If checked, then your ships will attempt to avoid collisions with other ships by default. "\
		                              "Hold <btn id='Game.InvertCollisionAvoidance'/> to use the other mode."

		EnableHazardAvoidance = "Navigate Around Environmental Hazards"
		EnableHazardAvoidanceTip = "If checked, then your ships will navigate around hazardous stars, electron clouds, and ion storms. "\
		                           "Hold <btn id='Game.InvertHazardAvoidance'/> to use the other mode."

		EnableArrivalMatching = "Enable Speed Synchronization"
		EnableArrivalMatchingTip = "If checked, then commanding multiple ships simultaneously will instruct them to synchronize their speeds so that they arrive at approximately the same time. "\
		                           "Double-right-click to disable speed synchronization for that specific command (or enable it if this option is unchecked)."

		AutoRecallCrew = "Automatically Recall Crew"
		AutoRecallCrewTip = "If checked, then moving your ship a long distance will automatically recall any outside crew back to it before moving."

		BreakFormationToAttack = "Opuszczanie Formacji Przy Ataku"
		BreakFormationToAttackTip = "Jeśli zaznaczone, statki automatycznie wyjdą z formacji w momencie osiągnięcia zasięgu ataku."

		ResourceDisplayMode = "Resource Counts"
		ResourceDisplayModeTip = "Which resource types should be displayed in the upper-right corner of the screen underneath the credits counter."
		ResourceDisplayModeContext = "Contextual"
		ResourceDisplayModeContextTip = "Only resources pointed at by the mouse cursor will be displayed."
		ResourceDisplayModeAll = "All"
		ResourceDisplayModeAllTip = "All resources types will be displayed."
		ResourceDisplayModeOwned = "Owned"
		ResourceDisplayModeOwnedTip = "Only resources that exist on the currently-selected ship(s) will be displayed."
		ResourceDisplayModeConstruction = "Construction"
		ResourceDisplayModeConstructionTip = "Only resources that can be used to build ships will be displayed."

		AutoSlowWhenEnemySpotted = "When Enemy Spotted"
		AutoSlowWhenEnemySpottedTip = "If enabled, the game will automatically pause or slow down to the selected speed whenever an enemy is spotted on radar. (The game will never speed up.)"
		AutoSlowWhenEnemySpottedPause = "Pause"
		AutoSlowWhenEnemySpottedSpeedFmt = "Slow to {0}"
		AutoSlowWhenEnemySpottedDisabled = "Disabled"

		BlipColorMode = "Kolor Sygnałów"
		BlipColorModeTip = "The colors that ship blips on the minimap and in the fog of war will appear as in multiplayer games. This setting does not affect any other players in the multiplayer game."

		RandomPerPlayer = "Losowy Kolor Gracza"
		RandomPerPlayerTip = "Ships will be assigned a random color that identifies which player controls them."

		RandomPerTeam = "Random Per Team"
		RandomPerTeamTip = "Ships will be assigned a random color that identifies which team they belong to. All players on the same team will be the same color."

		FriendAndFoe = "Sojusznik i Wróg"
		FriendAndFoeTip = "Ships you control will be green, ships of other players on the same team will be yellow, and ships on the enemy team will be red."

		ShowDamagePoints = "Show Damage Points"
		ShowDamagePointsTip = "If checked, then points earned from damaging enemy ships will be displayed over the enemy ship as the damage is done."

		PlayerName = "Display Name"
		PlayerNameTip = "Name displayed in multiplayer."
		PlayerNameDisabledTip =  "Cannot change your name while in a game."

		VelocityArrowsMode = "Velocity Arrows"
		VelocityArrowsModeTip = "Which ships should display their linear and angular velocity arrow overlays."
		VelocityArrowsModeAll = "All Ships"
		VelocityArrowsModeAllTip = "All ships will display velocity arrows."
		VelocityArrowsModeSelected = "Selected Ships"
		VelocityArrowsModeSelectedTip = "Only selected ships, or those with selected parts, will display velocity arrows."
		VelocityArrowsModeDirectControl = "Direct Control Only"
		VelocityArrowsModeDirectControlTip = "Only ships under direct control will display velocity arrows."
		VelocityArrowsModeNone = "None"
		VelocityArrowsModeNoneTip = "No ships will display velocity arrows."
	}

	Camera
	{
		TabName = "Kamera"

