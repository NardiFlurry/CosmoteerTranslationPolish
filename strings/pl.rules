MissileTypes
{
	HE = "High-Explosive Missiles"
	HEDesc = "Guided missiles that cause significant damage in a small area."
	EMP = "E.M.P. Missile"
	EMPDesc = "A large, guided missile that emits an electromagnetic pulse upon impact, draining power from enemy systems in a very large area."
	Nuke = "Tactical Nuclear Missile"
	NukeDesc = "A huge missile that causes a powerful nuclear explosion and massive damage in a very large area."
	Mine = "Proximity Mines"
	MineDesc = "Stationary mines that detonate in proximity to enemy ships, shooting out damaging shrapnel."
	Thermal = "Thermal Canister Missiles"
	ThermalDesc = "Guided missiles that take waste heat from their own ship and apply it to their target's hull in a small area. Must be connected to a heat pipe and supplied with heat in order to fire."
}

