		MusicVolTip = "Controls the overall volume of all music."

		InterfaceVol = "Głośność Interfejsu"
		InterfaceVolTip = "Kontroluje poziom głośności dźwięków interfejsu."

		MuteWhenUnfocused = "Mute When Window Loses Focus"
		MuteWhenUnfocusedTip = "If checked, the game audio will be automatically muted when the game window is out of focus."

