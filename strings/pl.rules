		MiniviewLbl = "Tryb PIP"

		EdgePan = "Przesuwanie widoku (Kursor)"
		EdgePanTip = "Decyduje o tym czy widok może być przesuwany poprzez skierowanie kursora do krawędzi ekranu."
		EdgePanNone = "Wyłączony"
		EdgePanNoneTip = "Widok nie będzie przesuwany przy skierowaniu kursora do krawędzi ekranu. Można go przesuwać używając klawiszy strzałek i środkowego przyciska myszy."
		EdgePanAnalog = "Analogowe"
		EdgePanAnalogTip = "W momenicie skierowania kursora do krawędzi ekranu, widok przesunie się w stronę odpowiadającą lini rysowanej ze środka ekranu do kursora."
		EdgePanEightWay = "Ośmiokierunkowe"
		EdgePanEightWayTip = "W momenicie skierowania kursora do krawędzi ekranu, widok przesunie się tylko w jeden z 8 "\
		                     "directions depending on which side or corner the mouse cursor is touching."

		EdgePanSpeed = "Szybkość Przesuwania Widoku (Kursor)"
		EdgePanSpeedTip = "Kontroluje jak szybko widok będzie przesuwany przy skierowaniu kursora do krawędzi ekranu."

		KeyPanSpeed = "Szybkość Przesuwania Widoku (Klawisze)"
		KeyPanSpeedTip = "Kontroluje jak szybko widok będzie przesuwany przy użyciu klawiszy kierunkowych."

		KeyZoomSpeed = "Szybkość Przybliżania Widoku (Klawisze)"
		KeyZoomSpeedTip = "Kontroluje jak szybko widok jest przybliżany i oddanlany przy użyciu klawiszy <btn id='View.ZoomIn'/> oraz <btn id='View.ZoomOut'/>."

		KeyRotSpeed = "Szybkość Obracania Widoku (Klawisze)"
		KeyRotSpeedTip = "Kontroluje jak szybko widok jest obracany przy użyciu klawiszy <btn id='View.RotateLeft'/> oraz <btn id='View.RotateRight'/>."

		EnableMouseWheelZoom = "Przybliżaj Przy Użyciu Kółka Myszy"
		EnableMouseWheelZoomTip = "Jeśli zaznaczone, będziesz mógł przybliżać i oddalać widok przy użyciu kólka myszy."

		WheelZoomSpeed = "Szybkość Przybliżania Widoku (Mysz)"
		WheelZoomSpeedTip = "Kontroluje jak szybko widok jest przybliżany i oddanlany przy użyciu kółka myszy."

		InvertWheelZoom = "Odwróć Przybliżanie/Oddalanie (mysz)"
		InvertWheelZoomTip = "Jeśli zaznaczone, obracanie kółka myszy daje odwrotny skutek."

		WheelZoomAtCursor = "Przybliżaj Do Kursora"
		WheelZoomAtCursorTip = "Jeśli zaznaczone, kółko myszy będzie przybliżać widok do kursora. "\
		                       "If not checked, it will zoom in and out of the center of the screen."

		RestoreZoomOnToolboxExit = "Restore Zoom When Exiting Editors"
		RestoreZoomOnToolboxExitTip = "If checked, then the camera zoom level will be restored when exiting the Ship Editor, Paint Editor, Crew Management, or Resource Management screens."

		ZoomOutOnFtl = "Zoom Out When Hyper-Jumping"
		ZoomOutOnFtlTip = "If checked, then the camera will automatically zoom out when plotting a hyper-jump within the local star system. (Hold <btn id='General.SuppressConfirmation'/> to use the other mode.)"

		DirectControlViewFollowsCursor = "View Follows Mouse Cursor"
		DirectControlViewFollowsCursorTip = "If checked, then the camera will be centered on a point between the ship and the mouse cursor. If not checked, then the camera will be centered on the ship."

		DirectControlAutoZoom = "Zoom Follows Mouse Cursor"
		DirectControlAutoZoomTip = "If checked, then the camera will automatically zoom in and out depending on the distance between the ship and the mouse cursor."

		DirectControlAutoRotate = "Match Ship Rotation"
		DirectControlAutoRotateTip = "If checked, then the camera will automatically rotate so that the ship is always facing up while in Direct Control Mode."

		DirectControlLockCameraToShip = "Lock Camera To Ship"
		DirectControlLockCameraToShipTip = "If checked, then the camera will not leave the ship while in Direct Control Mode."

		AutoTrack = "Automatically Track On-Screen Ships"
		AutoTrackTip = "If checked, then the camera will automatically match the movement of any on-screen ships."

		StickyFocus = "Kleiste Skupienie Widoku"
		StickyFocusTip = "Kiedy widok jest skupiony na statku, będzie on \"przyklejony\" do statku nawet po jego przesunięciu. "\
		                 "Focus will un-stick once the center of the view is moved outside the ship's circle."

		ShowMidpointFocusWidget = "Show Midpoint Focus \"Eye\" Icon"
		ShowMidpointFocusWidgetTip = "If checked, then an \"eye\" icon will be displayed between your ships and their targets. "\
		                             "Clicking it will focus the camera on the midpoint between the two ships."

		RotateMinimap = "Match Camera Rotation"
		RotateMinimapTip = "If checked, then the minimap will rotate to match the view rotation."

		MiniviewCombatModeLbl = "Podczas Walki"
		MiniviewCombatModeLblTip = "Wybierz kiedy okno podgłądowe jest wyświetlane podczas walki."
		MiniviewNonCombatModeLbl = "Poza Walką"
