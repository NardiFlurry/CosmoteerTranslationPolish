Parts
{
	// Terran

	StorageGeneric = "Skład Magazynowy"

	Storage2x2 = "Skład Magazynowy (4)"
	Storage2x2Icon = "Magazyn (4)"
	Storage2x2Desc = "Przechowuje 4 stack'i surowców każdego typu."

	Storage3x2 = "Skład Magazynowy (6)"
	Storage3x2Icon = "Magazyn (6)"
	Storage3x2Desc = "Przechowuje 6 stack'ów surowców każdego typu."

	Storage3x3 = "Skład Magazynowy (9)"
	Storage3x3Icon = "Magazyn (9)"
	Storage3x3Desc = "Przechowuje 9 stack'ów surowców każdego typu."

	Storage4x3 = "Skład Magazynowy (12)"
	Storage4x3Icon = "Magazyn (12)"
	Storage4x3Desc = "Przechowuje 12 stack'ów surowców każdego typu."

	Storage4x4 = "Skład Magazynowy (16)"
	Storage4x4Icon = "Magazyn (16)"
	Storage4x4Desc = "Przechowuje 16 stack'ów surowców każdego typu."

	Armor = "Pancerz"
	ArmorIcon = &Armor
	ArmorDesc = "Absorbuje znaczną ilość obrażeń przeciwnika, ochraniając galaretowate wnętrzności statku. Poza tym działa jako \"piorunochron\" dla efektów E.M.P."

	Armor1x2Wedge = "Pancerz 1x2 Klin"
	Armor1x2WedgeIcon = &Armor1x2Wedge
	Armor1x2WedgeDesc = &ArmorDesc

	Armor1x3Wedge = "Pancerz 1x3 Klin"
	Armor1x3WedgeIcon = &Armor1x3Wedge
	Armor1x3WedgeDesc = &ArmorDesc

	Armor2x1 = "Pancerz 2x1"
	Armor2x1Icon = &Armor2x1
	Armor2x1Desc = &ArmorDesc

	ArmorTri = "Pancerz Trójkąt"
	ArmorTriIcon = &ArmorTri
	ArmorTriDesc = &ArmorDesc

	ArmorWedge = "Pancerz Klin"
	ArmorWedgeIcon = &ArmorWedge
	ArmorWedgeDesc = &ArmorDesc

	ArmorStructureHybridTri = "Armor + Structure Triangle"
	ArmorStructureHybridTriIcon = "Arm. + Str.\nTriangle"
	ArmorStructureHybridTriDesc = &ArmorDesc

	ArmorStructureHybrid1x1 = "Armor + Structure Wedge"
	ArmorStructureHybrid1x1Icon = "Arm. + Str.\nWedge"
	ArmorStructureHybrid1x1Desc = &ArmorDesc

	ArmorStructureHybrid1x2 = "Armor + Structure 1x2 Wedge"
	ArmorStructureHybrid1x2Icon = "Arm. + Str.\n1x2 Wedge"
	ArmorStructureHybrid1x2Desc = &ArmorDesc

	ArmorStructureHybrid1x3 = "Armor + Structure 1x3 Wedge"
	ArmorStructureHybrid1x3Icon = "Arm. + Str.\n1x3 Wedge"
	ArmorStructureHybrid1x3Desc = &ArmorDesc

	CannonMed = "Standardowe Działo"
	CannonMedIcon = "Działo"
	CannonMedDesc = "Fires single rounds of projectile ammunition that can penetrate into enemy ships, sometimes starting fires."
	CannonMedOverclock = "Overclocked Standard Cannon"
	CannonMedOverclockDesc = "Fires salvos of multiple shells at higher velocity and longer range. Produces waste heat when firing."

	CannonLarge = "Duże Działo"
	CannonLargeIcon = &CannonLarge
	CannonLargeDesc = "Łączy cztery pociski co znacznie zwiększa uszkodzenia i penetrację pocisku w porównaniu do Standardowego działa."
	CannonLargeOverclock = "Overclocked Large Cannon"
	CannonLargeOverclockDesc = "Causes each cannon shell to break apart upon impact into multiple smaller incendiary shells that each continue penetrating into the target ship. Produces waste heat when firing."

	CannonDeck = "Deck Cannon"
	CannonDeckIcon = &CannonDeck
	CannonDeckDesc = "A huge double-barreled cannon that is mounted on top of the ship instead of the side for extra stability. Each barrel fuses together ten rounds of projectile ammunition and is so loud that it briefly stuns nearby crew.\n\n"\
	                 "The front and sides cannot be within 2 tiles of other roof turrets or \"tall\" parts."
	CannonDeckOverclock = "Overclocked Deck Cannon"
	CannonDeckOverclockDesc = "Increases shell damage, velocity, and accuracy, but lowers rate of fire and stops penetration once its damage potential is exhausted. Produces waste heat when firing."

	ChainGun = "Chaingun"
	ChainGunIcon = &ChainGun
	ChainGunDesc = "A powerful rotary cannon that increases its rate of fire the longer it shoots and hides behind a protective shell while not shooting. Additional ammunition magazines can be attached to increase its duration and rate of fire."
	ChainGunOverclock = "Overclocked Chaingun"
	ChainGunOverclockDesc = "Projectiles become explosive-tipped, causing splash damage and greater overall destruction, but reduces rate of fire and requires the Chaingun to rest briefly after every four shots. Produces waste heat when firing."

	ChaingunMagazine = "Chaingun Magazine"
	ChaingunMagazineIcon = &ChaingunMagazine
	ChaingunMagazineDesc = "An extra ammunition storage for the Chaingun, increasing its duration and rate of fire. Must be attached to the lower left or right sides of the chaingun."

	ControlRoomSmall = "Kokpit"
	ControlRoomSmallIcon = &ControlRoomSmall
	ControlRoomSmallDesc = "Allows the ship to fly and coordinate its weapons by providing <good>+50<image name='command_points' colored='true'/></good> Command Points. "\
	                       "A ship cannot be controlled if its weapons, thrusters, and other systems use more Command Points than it has available."

	ControlRoomMed = "Control Room"
	ControlRoomMedIcon = &ControlRoomMed
	ControlRoomMedDesc = "Allows the ship to fly and coordinate its weapons by providing <good>+250<image name='command_points' colored='true'/></good> Command Points. "\
	                     "A ship cannot be controlled if its weapons, thrusters, and other systems use more Command Points than it has available."

	ControlRoomLarge = "Bridge"
	ControlRoomLargeIcon = &ControlRoomLarge
	ControlRoomLargeDesc = "Allows the ship to fly and coordinate its weapons by providing <good>+1000<image name='command_points' colored='true'/></good> Command Points. "\
	                       "A ship cannot be controlled if its weapons, thrusters, and other systems use more Command Points than it has available."

	Conveyor = "Chodnik Automatyczny"
	ConveyorIcon = &Conveyor
	ConveyorDesc = "Pozwala załodze na szybsze przemieszczanie się, ale tylko w jedną stronę."

	Corridor = "Korytarz"
	CorridorIcon = "Korytarz"
	CorridorDesc = "Korytarz przez który załoga szybko się przemieszcza."

	CrewQuartersLarge = "Crew's Barracks"
	CrewQuartersLargeIcon = "Barracks"
	CrewQuartersLargeDesc = "Provides beds for 24 crew."

	CrewQuartersMed = "Kwatera Załogi"
	CrewQuartersMedIcon = "Kwatery"
	CrewQuartersMedDesc = "Zapewnia łóżka dla 6 załogantów."

	CrewQuartersSmall = "Prycza Załogi"
	CrewQuartersSmallIcon = "Prycza"
	CrewQuartersSmallDesc = "Zapewania łóżka dla 2 załogantów."

	Airlock = "Airlock Hatch"
	AirlockIcon = &Airlock
	AirlockDesc = "Allows crew to enter and exit the ship, such as to pick up resources or transfer between ships."

	Door = "Drzwi"
	DoorIcon = &Door
	DoorDesc = "Pozwala załodze (i ognowi!) przemieszczać się między pokojami."

	Disruptor = "Disruptor"
	DisruptorIcon = &Disruptor
	DisruptorDesc = "Fires bolts of electrical energy that deal little damage but can short-circuit enemy systems, causing them to lose power. Can penetrate shields while draining them."
	DisruptorOverclock = "Overclocked Disruptor"
	DisruptorOverclockDesc = "Allows disruptor bolts to phase through solid materials and causes the energy drain effect to linger after the initial impact, but reduces shield penetration and the instant energy drain on initial impact. Produces waste heat when firing."

	EngineRoom = "Engine Room"
	EngineRoomIcon = &EngineRoom
	EngineRoomDesc = "Increases the thrust and power usage of adjacent thrusters by 50%. Also acts as a central delivery point for adjacent thrusters to which crew can deliver batteries without having to travel to each one individually."
	EngineRoomOverclock = "Overclocked Engine Room"
	EngineRoomOverclockDesc = "Improves power efficiency when distributing power to attached thrusters, but produces waste heat while distributing power.\n\n"\
	                          "Additionally collects waste heat from attached thrusters, but produces additional waste heat while doing so."

	ExplosiveCharge = "Ładunek Wybuchowy"
	ExplosiveChargeIcon = &ExplosiveCharge
	ExplosiveChargeDesc = "Mały ładunek wybuchowy mogący być ręcznie zdetonowany. Używany głównie do celowego rozdzielania statku na wiele części."

	FactoryAmmo = "Cannon Ammo Factory"
	FactoryAmmoIcon = "Ammo"
	FactoryAmmoDesc = "Manufactures projectile ammunition used by cannons and railguns. Consumes sulfur. Gains +25% production speed for each adjacent factory of any type."
	FactoryAmmoOverclock = "Overclocked Cannon Ammo Factory"
	FactoryAmmoOverclockDesc = "Significantly increases production speed. Produces waste heat while producing ammo."

	FactoryHE = "High-Explosive Missile Factory"
	FactoryHEIcon = "H.E. Missiles"
	FactoryHEDesc = "Manufactures guided High-Explosive missiles that cause significant damage over a small area. Consumes iron and sulfur. Gains +25% production speed for each adjacent factory of any type."
	FactoryHEOverclock = "Overclocked High-Explosive Missile Factory"
	FactoryHEOverclockDesc = "Significantly increases production speed. Produces waste heat while producing missile parts."

	FactoryEMP = "E.M.P. Missile Factory"
	FactoryEMPIcon = "E.M.P. Missiles"
	FactoryEMPDesc = "Manufactures guided Electromagnetic Pulse missiles that drain power from enemy systems in a very large area. Consumes iron and copper. Gains +25% production speed for each adjacent factory of any type."
	FactoryEMPOverclock = "Overclocked E.M.P. Missile Factory"
	FactoryEMPOverclockDesc = "Significantly increases production speed. Produces waste heat while producing missile parts."

	FactoryNuke = "Nuclear Missile Factory"
	FactoryNukeIcon = "Nukes"
	FactoryNukeDesc = "Manufactures Tactical Nuclear Missiles that cause massive damage in a very large area. Consumes iron and uranium. Gains +25% production speed for each adjacent factory of any type."
	FactoryNukeOverclock = "Overclocked Nuclear Missile Factory"
	FactoryNukeOverclockDesc = "Significantly increases production speed. Produces waste heat while producing missile parts."

	FactoryMine = "Mine Factory"
	FactoryMineIcon = "Mines"
	FactoryMineDesc = "Manufactures mines that explode when in proximity to enemy ships, launching damaging shrapnel. Consumes iron and ammo. Gains +25% production speed for each adjacent factory of any type."
	FactoryMineOverclock = "Overclocked Mine Factory"
	FactoryMineOverclockDesc = "Significantly increases production speed. Produces waste heat while producing mine parts."

	FactoryThermal = "Thermal Canister Missile Factory"
	FactoryThermalIcon = "T.C. Missiles"
	FactoryThermalDesc = "Manufactures guided Thermal Canister Missiles that take thermal energy from their own ship's heat pipe network and inflict it upon the target in a small area of effect. Consumes copper and sulfur. Gains +25% production speed for each adjacent factory of any type."
	FactoryThermalOverclock = "Overclocked Thermal Canister Missile Factory"
	FactoryThermalOverclockDesc = "Significantly increases production speed. Produces waste heat while producing missile parts."

	FactorySteel = "Steel Smelter"
	FactorySteelIcon = "Steel"
	FactorySteelDesc = "Manufactures steel plates, which are used to construct almost all ship parts. Consumes iron. Gains +25% production speed for each adjacent factory of any type."
	FactorySteelOverclock = "Overclocked Steel Smelter"
	FactorySteelOverclockDesc = "Significantly increases production speed. Produces waste heat while producing steel."

	FactoryCoil = "Coil Factory"
	FactoryCoilIcon = "Coils"
	FactoryCoilDesc = "Manufactures coils, which are used to construct many ship parts. Consumes copper. Gains +25% production speed for each adjacent factory of any type."
	FactoryCoilOverclock = "Overclocked Coil Factory"
	FactoryCoilOverclockDesc = "Significantly increases production speed. Produces waste heat while producing coils."

	FactoryCoil2 = "Hyper-Coil Factory"
	FactoryCoil2Icon = "Hyper-Coils"
	FactoryCoil2Desc = "Manufactures hyper-coils, which are used to construct many advanced ship parts. Consumes copper and coils. Gains +25% production speed for each adjacent factory of any type."
	FactoryCoil2Overclock = "Overclocked Hyper-Coil Factory"
	FactoryCoil2OverclockDesc = "Significantly increases production speed. Produces waste heat while producing hyper-coils."

	FactoryTristeel = "Tri-Steel Smelter"
	FactoryTristeelIcon = "Tri-Steel"
	FactoryTristeelDesc = "Manufactures Tri-Steel plates, which are used to construct some advanced ship parts. Consumes tritanium. Gains +25% production speed for each adjacent factory of any type."
	FactoryTristeelOverclock = "Overclocked Tri-Steel Smelter"
	FactoryTristeelOverclockDesc = "Significantly increases production speed. Produces waste heat while producing tri-steel."

	FactoryDiamond = "Diamond Smelter"
	FactoryDiamondIcon = "Diamonds"
	FactoryDiamondDesc = "Manufactures diamonds, which are used to construct some advanced ship parts. Consumes carbon."

	FactoryProcessor = "Processor Fabricator"
	FactoryProcessorIcon = "Processors"
	FactoryProcessorDesc = "Manufactures processors, which are used to construct some advanced ship parts. Consumes gold and coils. Gains +25% production speed for each adjacent factory of any type."
	FactoryProcessorOverclock = "Overclocked Processor Fabricator"
	FactoryProcessorOverclockDesc = "Significantly increases production speed. Produces waste heat while producing processors."

	FactoryUranium = "Uranium Enricher"
	FactoryUraniumIcon = "Enr. Uranium"
	FactoryUraniumDesc = "Enriches uranium, which is needed to construct reactors and other advanced ship parts. Consumes unenriched uranium. Gains +25% production speed for each adjacent factory of any type."
	FactoryUraniumOverclock = "Overclocked Uranium Enricher"
	FactoryUraniumOverclockDesc = "Significantly increases production speed. Produces waste heat while producing enriched uranium."

	FireExtinguisher = "Szafka na Gaśnicę"
	FireExtinguisherIcon = "Gaśnica"
	FireExtinguisherDesc = "Przechowuje a fire extinguisher that crew can use to put out fires. Fire extinguishers have a limited capacity but a new one will be constructed out of thin air every 15 seconds."
	FireExtinguisherOverclock = "Overclocked Fire Extinguisher Closet"
	FireExtinguisherOverclockDesc = "Rapidly increases the construction speed of fire extinguishers. Produces ironic waste heat while constructing fire extinguishers."

	ManipulatorBeam = "Manipulator Beam Emitter"
	ManipulatorBeamIcon = "Manipulator Beam"
	ManipulatorBeamDesc = "Projects up to 16 small, roof-mounted tractor beams that can collect resources and boost flying crew. A single crew can control up to four beams, and they will only go to the Manipulator Beam Emitter when there are tasks to help with."

	RoofLight = "Exterior Light"
	RoofLightIcon = &RoofLight
	RoofLightDesc = "A small exterior light. Provides no practical benefit."

	RoofHeadlight = "Exterior Headlight"
	RoofHeadlightIcon = &RoofHeadlight
	RoofHeadlightDesc = "An exterior headlight that can be aimed. Provides no practical benefit."

	FlakCannonLarge = "Flak Array"
	FlakCannonLargeIcon = &FlakCannonLarge
	FlakCannonLargeDesc = "A powerful defensive system that can destroy enemy missiles, lasers, and projectiles. Can also inflict moderate damage to enemy ships."
	FlakCannonLargeOverclock = "Overclocked Flak Array"
	FlakCannonLargeOverclockDesc = "Flak shells are packed with shrapnel that lingers in space for a short while after detonation, damaging any projectiles and blocking any energy beams that pass through. Produces waste heat when firing."

	HyperdriveSmall = "Small Hyperdrive"
	HyperdriveSmallIcon = &HyperdriveSmall
	HyperdriveSmallDesc = "Allows the ship to instantaneously travel to other destinations within the solar system, to friendly ships with Hyperdrive Beacons, or when assisted by a Hyper-Jump Relay, to other solar systems."

	HyperdriveMed = "Medium Hyperdrive"
	HyperdriveMedIcon = "Med. Hyperdrive"
	HyperdriveMedDesc = "Allows the ship to instantaneously travel to other destinations within the solar system, to friendly ships with Hyperdrive Beacons, or when assisted by a Hyper-Jump Relay, to other solar systems.\n\n"\
	                    "Has a greater hyperium capacity and larger efficiency radius than the Small Hyperdrive."

	HyperdriveLarge = "Large Hyperdrive"
	HyperdriveLargeIcon = &HyperdriveLarge
	HyperdriveLargeDesc = "Allows the ship to instantaneously travel to other destinations within the solar system, to friendly ships with Hyperdrive Beacons, or when assisted by a Hyper-Jump Relay, to other solar systems.\n\n"\
	                    "Has a greater hyperium capacity and larger efficiency radius than the Small or Medium Hyperdrives."

	IonBeamEmitter = "Emiter Promienia Jonowego"
	IonBeamEmitterIcon = "Promień Jonowy"
	IonBeamEmitterDesc = "Shoots a powerful beam of ion energy in a fixed direction. Damage is lower at longer range. Can be shot into an Ion Beam Prism to redirect its angle."
	IonBeamEmitterOverclock = "Overclocked Ion Beam Emitter"
	IonBeamEmitterOverclockDesc = "Causes the ion beam to destabilize near its target, creating chaotic and powerful lightning strikes in an area around it, but prevents the beam itself from directly hitting its target. Produces waste heat when firing."

	IonBeamPrism = "Ion Beam Prism"
	IonBeamPrismIcon = "Ion Prism"
	IonBeamPrismDesc = "Redirects the angles of incoming ion beams, aiming them at enemy ships or other Ion Beam Prisms."

	ResonanceBeamTurret = "Thermal Resonance Lance"
	ResonanceBeamTurretIcon = "Thermal Resonance Lance"
	ResonanceBeamTurretDesc = "A roof-mounted turret that fires a beam of pure heat energy but also produces a great deal of its own waste heat. Weakens shields around the impact point.\n\n"\
								"Cannot be within 2 tiles of other roof turrets or \"tall\" parts."

	Radiator = "Radiator"
	RadiatorIcon = "Radiator"
	RadiatorDesc = "Dissipates heat from the connected thermal network. Dissipation effectiveness is reduced if the area in front of the radiator is blocked."
	RadiatorDissipationScoreFmt = "<good>{1:0.#}%\n({0:0.#}<gray>/sec</gray>)</good>"

	HeatExchanger = "Heat Exchanger"
	HeatExchangerIcon = "Heat Exchanger"
	HeatExchangerDesc = "Absorbs heat from the hull, transferring it to the connected thermal network while generating some additional waste heat."

	ThermalBattery = "Thermal Battery"
	ThermalBatteryIcon = "Thermal Battery"
	ThermalBatteryDesc = "Safely contains large amounts of thermal energy, providing additional heat storage to the connected thermal network."

	HeatPipeCrossing = "Heat Pipe Crossing"
	HeatPipeCrossingIcon = "Heat Pipe Crossing"
	HeatPipeCrossingDesc = "<string id='Parts/HeatPipeAdaptiveDesc'/> Allows crew to walk underneath the pipe."

	HeatPipeAdaptive = "Heat Pipe"
	HeatPipeAdaptiveIcon = "Heat Pipe"
	HeatPipeAdaptiveDesc = "Instantaneously transfers thermal energy between connected parts."

	HeatPipeAdaptiveStructure = "Heat Pipe Structure"
	HeatPipeAdaptiveStructureIcon = "Heat Pipe Structure"
	HeatPipeAdaptiveStructureDesc = &HeatPipeAdaptiveDesc

	ThermalDilationPump = "Lance Dilation Pump"
	ThermalDilationPumpIcon = "Lance Dilation Pump"
	ThermalDilationPumpDesc = "Increases the heat area-of-effect for all Thermal Resonance Lances connected to the same thermal network. Both of the pump's ports must be connected to achieve full effect."

	ThermalAmplificationPump = "Lance Amplification Pump"
	ThermalAmplificationPumpIcon = "Lance Amplification Pump"
	ThermalAmplificationPumpDesc = "Increases the heat intensity for all Thermal Resonance Lances connected to the same thermal network."

	LaserBlasterSmall = "Działo Laserowe"
	LaserBlasterSmallIcon = "Laser"
	LaserBlasterSmallDesc = "Celna i wszechstronna broń, strzelająca pojedyńczymi ładunkami energii, zadając średnie uszkodzenia wrogim statkom."
	LaserBlasterSmallOverclock = "Overclocked Laser Blaster"
	LaserBlasterSmallOverclockDesc = "Increases the rate of fire and replaces the laser bolts with instantaneous energy beams, but lowers the damage of each shot. Produces waste heat when firing."

	LaserBlasterLarge = "Ciężkie Działo Laserowe"
	LaserBlasterLargeIcon = "Ciężkie Działo"
	LaserBlasterLargeDesc = "Łączy ze sobą dwa duże działa laserowe na jednej wieżyczce, co daje o wiele większą moc, przy utracie celności i wszechstronności."
	LaserBlasterLargeOverclock = "Overclocked Heavy Laser Blaster"
	LaserBlasterLargeOverclockDesc = "Increases the damage of each laser bolt and adds splash damage, but reduces the rate of fire. Produces waste heat when firing."

	MissileLauncher = "Wyrzutnia Rakiet i Min"
	MissileLauncherIcon = "Wyrzutnia"
	MissileLauncherDesc = "Launches missiles or mines of any type.\n\nThe type of munition launched can be changed at any time during or after construction, even during battle."

	PointDefense = "System Obrony Punktowej"
	PointDefenseIcon = "Obrona Punktowa"
	PointDefenseDesc = "Zautomatyzowany system defensywny zestrzeliwujący wrogie rakiety oraz pociski przy użyciu rozgrzanych kul plazmy. Może także zadać lekkie obrażenia wrogim statkom."
	PointDefenseOverclock = "Overclocked Point Defense System"
	PointDefenseOverclockDesc = "Turns on a dynamo that slowly regenerates power, allowing the Point Defense System to fire for short periods without ever receiving batteries. Produces waste heat while regenerating."

	PowerStorage = "Magazyn Mocy"
	PowerStorageIcon = "Magazyn Mocy"
	PowerStorageDesc = "Magazynuje ograniczoną ilość baterii plazmowych, które mogą zostać użyte do zasilenia pobliskich systemów."
	PowerStorageOverclock = "Overclocked Power Capacitor"
	PowerStorageOverclockDesc = "Triples the power capacity of both the Power Capacitor itself and the individual stored batteries. Produces waste heat continuously while storing power and additionally when receiving power."

	Railgun = "Działo Elektromagnetyczne"
	RailgunDesc = "A variable-length modular weapon that fires magnetically accelerated projectiles that can penetrate deep into enemy ships, causing great damage."
	RailgunOverclock = "Overclocked Railgun"

	RailgunBaseDesc = "Railguns fire magnetically accelerated projectiles that can penetrate deep into enemy ships, causing great damage. "\
	                  "Each Railgun requires both a Loader and a Launcher, plus any number of optional Accelerators."

	RailgunLauncher = "Moduł Wyrzutni Działa Elektromagnetycznego"
	RailgunLauncherIcon = "Wyrzutnia"
	RailgunLauncherDesc = "A required component of all railguns. Must be paired with a Loader and zero or more Accelerators.\n\n"\
	                      "<string id='Parts/RailgunBaseDesc'/>\n\n"\
	                      "Crew cannot walk from one side of a Railgun Launcher or Accelerator to the other."
						  
	RailgunLauncherOverclockDesc = "Improves the efficiency of longer Railguns and increases projectile speed and damage, but requires a charge-up before firing and stops penetration once its damage potential is exhausted. Produces waste heat when firing."

	RailgunLoader = "Moduł Ładujący Działa Elektromagnetycznego"
	RailgunLoaderIcon = "Moduł Ładujący"
	RailgunLoaderDesc = "A required component of all railguns. Must be paired with a Launcher and zero or more Accelerators.\n\n"\
	                    "<string id='Parts/RailgunBaseDesc'/>"

	RailgunAccelerator = "Moduł Akceleratora Działa Elektromagnetycznego"
	RailgunAcceleratorIcon = "Akcelerator"
	RailgunAcceleratorDesc = "Opcjonalna część znajdująca się pomiędzy Modułem Ładującym a Wyrzutnią Działa Elektromagnetycznego. Każdy akcelerator zwiększa prędkość, penetrację, oraz uszkodzenia pocisku.\n\n"\
	                         "<string id='Parts/RailgunBaseDesc'/>\n\n"\
	                         "Crew cannot walk from one side of a Railgun Launcher or Accelerator to the other."

	ReactorSmall = "Mały Rdzeń Reaktora"
	ReactorSmallIcon = "Mały Reaktor"
	ReactorSmallDesc = "Produkuje baterie plazmowe zasilające większość systemów statku."
	ReactorSmallOverclock = "Overclocked Small Reactor Core"
	ReactorSmallOverclockDesc = "Increases maximum power capacity and generation rate. Produces waste heat while generating power."

	ReactorMed = "Średni Rdzeń Reaktora"
	ReactorMedIcon = "Średni Reaktor"
	ReactorMedDesc = "A power generator that produces double-capacity plasma batteries needed to power many of the ship's systems."
	ReactorMedOverclock = "Overclocked Medium Reactor Core"
	ReactorMedOverclockDesc = "Increases maximum power capacity and generation rate. Produces waste heat while generating power."

	ReactorLarge = "Duży Rdzeń Reaktora"
	ReactorLargeIcon = "Duży Reaktor"
	ReactorLargeDesc = "A power generator that produces triple-capacity plasma batteries needed to power many of the ship's systems."
	ReactorLargeOverclock = "Overclocked Large Reactor Core"
	ReactorLargeOverclockDesc = "Increases maximum power capacity and generation rate. Additionally increases battery size from triple-capacity to quadruple-capacity. Produces waste heat while generating power."

	SensorArray = "Układ Czujników"
	SensorArrayIcon = "Czujniki"
	SensorArrayDesc = "Zwiększa zasięg czujników twojego statku. (Nie stakuje się z innymi układami czujników.)"
	SensorArrayOverclock = "Overclocked Sensor Array"
	SensorArrayOverclockDesc = "Increases the visual range of the Sensor Array. Produces heat while operating."

	HyperdriveBeacon = "Boja Skoku Nadprzestrzeni"
	HyperdriveBeaconIcon = "Boja Skoku Nadprzestrzeni"
	HyperdriveBeaconDesc = "Ships with Hyperdrives can jump to ships with Hyperdrive Beacons."

	ShieldGenSmall = "Mały Generator Osłon"
	ShieldGenSmallIcon = "Mała Osłona"
	ShieldGenSmallDesc = "Projects a small defensive energy shield in an arc outside the ship, blocking most incoming fire. Vulnerable to Disruptors and EMPs.\n\n"\
	                     "Due to its small size, the energy shield can be projected through the ship itself, allowing the Small Shield Generator to be built within the ship's protected interior."
	ShieldGenSmallOverclock = "Overclocked Small Shield Generator"
	ShieldGenSmallOverclockDesc = "Enables choosing between two modes for the energy shield:\n\n1. The energy shield expands to cover a larger area.\n\n2. The energy shield shrinks to cover a smaller area but becomes stronger and loses less power per hit.\n\nProduces waste heat when hit."

	ShieldGenLarge = "Large Shield Generator"
	ShieldGenLargeIcon = "Large Shield"
	ShieldGenLargeDesc = "Projects a large defensive energy shield in an arc outside the ship, blocking most incoming fire. Vulnerable to Disruptors and EMPs.\n\n"\
	                     "Due to its large size, the energy shield cannot be projected through any ship parts (except structure), requiring the Large Shield Generator to be built on the ship's vulnerable exterior."
	ShieldGenLargeOverclock = "Overclocked Large Shield Generator"
	ShieldGenLargeOverclockDesc = "The energy shield shrinks to cover a smaller area but becomes stronger and loses less power per hit. Produces waste heat when hit."

	Structure = "Rama"
	StructureIcon = &Structure
	StructureDesc = "Szkielet konstrukcji, który trzyma statek w całości. Struktura jest automatycznie budowana wraz ze wszystkimi pokojami i korytarzami."

	Structure1x2Wedge = "Rama 1x2 Klin"
	Structure1x2WedgeIcon = &Structure1x2Wedge
	Structure1x2WedgeDesc = &StructureDesc

	Structure1x3Wedge = "Rama 1x3 Klin"
	Structure1x3WedgeIcon = &Structure1x3Wedge
	Structure1x3WedgeDesc = &StructureDesc

	StructureTri = "Rama Trójkąt"
	StructureTriIcon = &StructureTri
	StructureTriDesc = &StructureDesc

	StructureWedge = "Rama Klin"
	StructureWedgeIcon = &StructureWedge
	StructureWedgeDesc = &StructureDesc

	ThrusterBoost = "Dopalacz"
	ThrusterBoostIcon = &ThrusterBoost
	ThrusterBoostDesc = "Wariant Dużego Silnika Rakietowego mogący wstrzykiwać surową plasmę bezpośrednio w swą komorę spalania dla potężnego ale krótkiego doładowania. Zasilanie nie może zostać dostarczone podczas użytku."
	ThrusterBoostOverclock = "Overclocked Boost Thruster"
	ThrusterBoostOverclockDesc = "Greatly increases thrust and moderately improves power efficiency without affecting ramp times, but also increases power consumption. Produces waste heat while firing.\n\n"\
	                             "Additionally allows the Boost Thruster to be refueled while boosting, but every additional battery increases the rate of waste heat production."

	ThrusterHuge = "Wielki Silnik Rakietowy"
	ThrusterHugeIcon = &ThrusterHuge
	ThrusterHugeDesc = "Wielki silnik rakietowy o mocy dwa razy większej niż Duży Silnik Rakietowy. Potrzebuje dużo czasu by osiągnąć masymalną moc."
	ThrusterHugeOverclock = "Overclocked Huge Thruster"
	ThrusterHugeOverclockDesc = "Greatly increases thrust and minorly improves power efficiency without affecting ramp times, but also increases power consumption. Produces waste heat while firing."

	ThrusterLarge = "Duży Silnik Rakietowy"
	ThrusterLargeIcon = &ThrusterLarge
	ThrusterLargeDesc = "Dwa razy większy niż Silnik Rakietowy, ma też dwa razy większą moc niż Silnik Rakietowy. Potrzebuje średniej ilości czasu by osiągnąć masymalną moc."
	ThrusterLargeOverclock = "Overclocked Large Thruster"
	ThrusterLargeOverclockDesc = "Greatly increases thrust and moderately improves power efficiency without affecting ramp times, but also increases power consumption. Produces waste heat while firing."

	ThrusterMed = "Silnik Rakietowy"
	ThrusterMedIcon = &ThrusterMed
	ThrusterMedDesc = "Standardowy silnik rakietowy zdolny ruszyć statkiem ze średnią mocą napędową. Potrzebuje mało czasu by osiągnąć masymalną moc."
	ThrusterMedOverclock = "Overclocked Standard Thruster"
	ThrusterMedOverclockDesc = "Greatly increases thrust and power efficiency without affecting ramp times, but also increases power consumption. Produces waste heat while firing."

	ThrusterSmall = "Mały Silnik Rakietowy"
	ThrusterSmallIcon = &ThrusterSmall
	ThrusterSmallDesc = "Słaby Silnik Rakietowy, używany głównie do manewrowania. Posiada małe dynamo które powoli regeneruje moc."
	ThrusterSmallOverclock = "Overclocked Small Thruster"
	ThrusterSmallOverclockDesc = "Greatly increases thrust and power efficiency while significantly improving dynamo power generation, but also increases power consumption. Produces waste heat while firing."

	ThrusterSmall2Way = "Dwukierunkowy Mały Silnik Rakietowy"
	ThrusterSmall2WayIcon = "Mały Silnik Rakietowy"
	ThrusterSmall2WayDesc = "Słaby, Dwukierunkowy Silnik Rakietowy, używany głównie do manewrowania. Posiada małe dynamo które powoli regeneruje moc."

	ThrusterSmall3Way = "Trójkierunkowy Mały Silnik Rakietowy"
	ThrusterSmall3WayIcon = "Mały Silnik Rakietowy"
	ThrusterSmall3WayDesc = "Słaby, Trójkierunkowy Silnik Rakietowy, używany głównie do manewrowania. Posiada małe dynamo które powoli regeneruje moc."

	ThrusterRocket = "Modular Rocket Thruster (M.R.T.)"
	ThrusterRocketDesc = "A variable-length modular thruster that can accelerate ships up to very high speeds but takes a long time to ramp up to its full power, making it ineffective at maneuvering."

	ThrusterRocketBaseDesc = "Modular Rocket Thrusters (M.R.T.) can accelerate ships up to very high speeds but take a long time to ramp up to their full power, making them ineffective at maneuvering. "\
	                         "Each M.R.T. requires a Nozzle plus zero or more optional Extenders and Fuel Pods."

	ThrusterRocketNozzle = "M.R.T. Nozzle Module"
	ThrusterRocketNozzleIcon = "M.R.T. Nozzle"
	ThrusterRocketNozzleDesc = "A required component of all Modular Rocket Thrusters. May be combined with zero or more Extender modules and up to two Fuel Pods per Nozzle or Extender.\n\n"\
	                           "<string id='Parts/ThrusterRocketBaseDesc'/>"
	ThrusterRocketNozzleOverclock = "Overclocked M.R.T. Nozzle Module"
	ThrusterRocketNozzleOverclockDesc = "Reduces the impact of Extender Modules on ramp-up time. Produces waste heat while firing."

	ThrusterRocketExtender = "M.R.T. Extender Module"
	ThrusterRocketExtenderIcon = "M.R.T. Extender"
	ThrusterRocketExtenderDesc = "An optional component placed behind a Modular Rocket Thruster's Nozzle or other Extender. Each extender increases its maximum thrust, power usage, and ramp-up time. Battery fuel capacity may be extended with up to two Fuel Pods.\n\n"\
	                             "<string id='Parts/ThrusterRocketBaseDesc'/>"
 	ThrusterRocketExtenderOverclock = "Overclocked M.R.T. Extender Module"
 	ThrusterRocketExtenderOverclockDesc = "Increases both the Nozzle Module's base thrust <i>and</i> the thrust of <i>every</i> attached Extender Module. Produces waste heat while firing."

	ThrusterRocketBattery = "M.R.T. Fuel Pod"
	ThrusterRocketBatteryIcon = &ThrusterRocketBattery
	ThrusterRocketBatteryDesc = "Extends the battery fuel capacity of an attached M.R.T. Nozzle or Extender by four batteries.\n\n"\
	                            "<string id='Parts/ThrusterRocketBaseDesc'/>"

	MiningLaserSmall = "Mining Laser"
	MiningLaserSmallIcon = &MiningLaserSmall
	MiningLaserSmallDesc = "A pair of roof-mounted precision laser beams that can quickly extract resources from even the toughest asteroids. Also effective at salvaging ships, and in a pinch can be used as a short-range weapon."
	MiningLaserSmallOverclock = "Overclocked Mining Laser"
	MiningLaserSmallOverclockDesc = "Adds an area-of-effect to both mining beams. Produces waste heat when firing."

	TractorBeamEmitter = "Tractor Beam Emitter"
	TractorBeamEmitterIcon = "Tractor Beam"
	TractorBeamEmitterDesc = "Emits a gravitation beam that pulls and pushes ships and other large objects."
	TractorBeamEmitterOverclock = "Overclocked Tractor Beam Emitter"
	TractorBeamEmitterOverclockDesc = "Significantly increases gravitational force in all modes, but restricts the force to always act upon the target's center of mass. Produces waste heat while firing.\n\n"\
									  "Additionally, allows the emitter to be overcharged, depleting its energy and emitting a massive wave of gravitational energy in all directions, which also produces a large amount of waste heat."

	WallHole = "Dziura"
	WallHoleDesc = "Dziura wyrwana w ścianie."

