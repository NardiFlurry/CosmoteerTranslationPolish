{
	Detonate = "Detonate Explosive Charge\n\nHotkey: <btn id='PartTriggers.detonate'/>"
}

PartToggles
{
	OnOff_Off = "<b>Zasilanie: <bad>Wyłączone</bad></b>\n\nSkrót: <btn id='PartToggles.on_off_off'/>"
	OnOff_On = "<b>Zasilanie: <good>Włączone</good></b>\n\nSkrót: <btn id='PartToggles.on_off_on'/>"

	FireMode_Hold = "<b>Hold Fire</b>\nDon't fire under any circumstances.\n\nHotkey: <btn id='PartToggles.fire_mode_hold'/>"
	FireMode_AtTarget = "<b>Fire At Target</b>\nFire only when given a target.\n\nHotkey: <btn id='PartToggles.fire_mode_at_target'/>"
	FireMode_AtWill = "<b>Fire At Will</b>\nFire at all enemies within range.\n\nHotkey: <btn id='PartToggles.fire_mode_at_will'/>"
	FireMode_Auto = "<b>Auto-Fire</b>\nFire continuously, even if there is nothing to shoot at.\n\nHotkey: <btn id='PartToggles.fire_mode_auto'/>"

	Rotate_Off = "<b>Rotate: <bad>Off</bad></b>\n\nHotkey: <btn id='PartToggles.rotate_off'/>"
	Rotate_On = "<b>Rotate: <good>On</good></b>\n\nHotkey: <btn id='PartToggles.rotate_on'/>"

	FirePref_Attack = "<b>Attack</b>\nOnly fire at enemy ships.\n\nHotkey: <btn id='PartToggles.fire_pref_attack'/>"
	FirePref_Defend = "<b>Defend</b>\nOnly fire at incoming projectiles. This will also make the weapon ignore any ship-wide targeting commands.\n\nHotkey: <btn id='PartToggles.fire_pref_defend'/>"
	FirePref_Both = "<b>Attack + Defend</b>\nFire at both enemy ships and incoming projectiles.\n\nHotkey: <btn id='PartToggles.fire_pref_both'/>"

	Fire_Synchronized = "<b>Fire: Synchronized</b>\n\nHotkey: <btn id='PartToggles.fire_alternating_off'/>"
	Fire_Alternating = "<b>Fire: Alternating</b>\n\nHotkey: <btn id='PartToggles.fire_alternating_on'/>"

