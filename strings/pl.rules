Missions
{
	ResourceDelivery = "Dostarczyć {resource_type}"
	ResourceDeliveryDesc = "{to_ship} is requesting an emergency supply of {target_count} {resource_icon} {resource_type_plural} within {time_limit_minutes} minutes. "\
	                       "In addition to standard payment for each {resource_type} delivered, an extra bonus of {money} will be paid once the entire delivery has been completed."
	Bounty = "Dezerter"
	BountyDesc = "A fugitive <b>{target_ship}</b> class vessel is wanted for illegal activities within the {mission_location} system. Authorities from the {faction_name} have posted a bounty of {money} to be paid to any Cosmoteer that can eliminate it."
	FleetBounty = "Paczka Renegatów"
	FleetBountyDesc = "A pack of renegade vessels is wanted for harassing and extorting civilians within the {mission_location} system. Authorities from the {faction_name} have posted a bounty of {money} to be paid to any Cosmoteer that can eliminate them."
	PirateHunt = "Łowca Piratów"
	PirateHuntDesc = "Roving pirates have been attacking civilian trade ships in the {mission_location} system, disrupting the profits of local businesses. The business owners have posted a bounty of {money} to be paid to any Cosmoteer that can destroy {target_count} of them."
	FactionHunt = "Łowca {target_faction}"
	FactionHuntDesc = "The {faction_name} is at war with the {target_faction} and is offering payment of {money} to any private contractor who can eliminate {target_count} of their ships patrolling the {mission_location} System."
	ClearAsteroidField = "Oczyszczanie Pola Asteroid"
	ClearAsteroidFieldPiratesDesc = "A handful of pirates have been preying on civilian mining vessels in a nearby asteroid field. The mining companies have posted a bounty of {money} to be paid to any Cosmoteer that can clear the asteroid field of pirates."
	ClearAsteroidFieldPlatformsDesc = "Pirates have constructed several stationary defense platforms in a nearby asteroid field that are making it too dangerous for legitimate civilian miners. The mining companies have posted a bounty of {money} to be paid to any Cosmoteer that can clear the asteroid field of those defense platforms."
	StationContact = "Skontaktuj się z {contact_ship}"
	StationContactDesc = "{contact_ship} is requesting assistance from any available Cosmoteer to help with a variety of missions. As an added incentive, the station's Mission Board Department is offering a {money} bonus to the first Cosmoteer to visit the station."
	StationRescue = "Ocal {contact_ship}"
	StationRescueDesc = "A distress signal has been received from {contact_ship}! Bandits are attacking the station in overwhelming numbers! The station's governor is promising {money} to any Cosmoteer who can destroy the bandits and rescue the station."
	PirateBaseDestruction = "Zniszcz Bazę Piratów"
	PirateBaseDestructionDesc = "The location of a local pirate fleet's home base has been discovered! These pirates have been brazenly preying on {faction_name} patrol ships within the system and must be eliminated. Authorities from the {faction_name} have posted a considerable bounty of {money} to be paid to any Cosmoteer brave and competent enough to destroy it."
	FactionBaseDestruction = "Zniszcz Bazę {target_faction}"
	FactionBaseDestructionDesc = "The {faction_name} is at war with the {target_faction} and is offering payment of {money} to any private contractor who can eliminate one of its munitions supply bases in the {mission_location} System."
	Explore = "Odkryj {mission_location} ({discover_perc:0}%)"
	ExploreDesc = "Cosmotographers from the {faction_name} are requesting data about various locations of interest within the {mission_location} System."
	VisitSystem = "Odwiedź {mission_location}"
	VisitSystemDesc = "A prominent cosmotographer is requesting data about solar activity in the {mission_location} System."
