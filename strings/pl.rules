	Graphics
	{
		TabName = "Grafika"

		DisplayLbl = "Display"
		PerformanceLbl = "Performance"

		Language = "Język"
		LanguageTip = "The language to use for the user interface."

		WindowMode = "Tryb okna"
		WindowModeTip = "Rodzaj okna w jakim będzie wyświetlana gra."
		ExclusiveFullScreen = "Tryb Pełnoekranowy Zaawansowany"
		ExclusiveFullScreenTip = "Okno gry zajmuje cały monitor i możesz wybrać rozdzielczość ekranu. "\
		                         "This mode may be required to utilize some advanced GPU features such as G-SYNC and FreeSync."
		ResizableWindow = "Tryb Okna"
		ResizableWindowTip = "Gra będzie wyświetlana w oknie na twoim komputerze. Możesz Dowolnie manipulować kształtem i położeniem okna."
		BorderlessFullScreen = "Tryb Pełnoekranowy"
		BorderlessFullScreenTip = "Okno gry zajmuje cały monitor, a gra wyświatlana jest w standardowej rozdzielczości ekranu. "\
		                          "Use this mode if Exclusive Full Screen causes problems or if you want to be able to quickly switch to other applications."

		Monitor = "Ekran"
		MonitorTip = "Ekran na którym gra będzie wyświetlana w Zaawansowanym Trybie Pełnoekranowym lub Trybie Pełnoekranowym Bez Krawędzi."

		Resolution = "Rozdzielczość"
		ResolutionTip = "Rozdzielczość ekranu w jakiej gra będzie wyświetlana gdy wybrany jest Zaawansowany Tryb Pełnoekranowy."
		ResolutionFmt = "{0} x {1}"

		RefreshRate = "Częstotliwość Odświeżania"
		RefreshRateTip = "Ilość klatek wyświetlanych przez ekran w ciągu sekundy."
		RefreshRateFmt = "{0} hz"

		VSync = "VSync"
		VSyncTip = "Decyduje o tym czy gra będzie zsynchronizowana z częstotliwością odświerzania monitora co eliminuje rozrywanie obrazu ale zwiększa opóźnienie wejściowe."
		VSyncOff = "Wyłączony"
		VSyncOffTip = "Gra nie będzie zsynchronizowana z częstotliwością odświerzania twojego monitora. Będzie ona działałą z maksymalną możliwą ilością FPS-ów i minimalnym opóźnieniem wejściowym."
		VSyncOn = "Włączony"
		VSyncOnTip = "Gra nie będzie zsynchronizowana z częstotliwością odświerzania twojego monitora. "\
		             "This will eliminate screen tearing but will also limit the frame rate to your monitor's refresh rate and may increase input lag."
		VSyncTriBuf = "Włączony (Potrójne Buforowanie)"
		VSyncTriBufTip = "Ten wariant V-Sync może zwiększyć ilość FPS-ów ale dodatkowo zwiększa opóźnienie wejściowe."

		DpiScaling = "Skalowanie Interfejsu Użytkownika"
		DpiScalingTip = "Kontroluje wielkość interfjsu gracza. Zwiększanie tego parametru ponad 100% może ułatwić grę na wyższych rozdzielczościach."
		DpiScaleDisabledTip = "Wielkość okna gry lub rozdzielczość nie jest wystarczająco wysoka by wspierać te skalowanie D.P.I."
		Dpi100 = "100%"
		Dpi125 = "125%"
		Dpi150 = "150%"
		Dpi175 = "175%"
		Dpi200 = "200%"
		Dpi250 = "250%"
		Dpi300 = "300%"

		LockCursor = "Uwięź Kursor Myszy Wewnątrz Okna"
		LockCursorTip = "If checked, then the mouse cursor won't be able to leave the game window during gameplay. "\
		                "If playing in an Exclusive Full Screen window, then the cursor won't leave the window regardless of whether this option is selected."

		ResolutionScale = "Resolution Scale"
		ResolutionScaleTip = "Values above 100% will cause most graphics to be rendered at a higher resolution than the game window and then downscaled to match it. Higher values improve anti-aliasing (SSAA) quality but may significantly hurt performance, especially on low-end GPUs.\n\n"\
		                     "Values below 100% will cause most graphics to be rendered at a lower resolution than the game window and then upscaled to match it. Lower values will greatly worsen visuals but may also greatly improve performance on low-end GPUs."
		ResolutionScaleFmt = "{0}%"

		PlanetResolutionScale = "Planet Resolution"
		PlanetResolutionScaleTip = "Controls the resolution of the textures used to render background planets. Higher values will look better but will cause longer load times and use more VRAM. Requires restarting the current game instance to take effect."

		FpsTarget = "Minimum Target F.P.S."
		FpsTargetTip = "If the game's framerate (frames per second) falls below this number, then the game will automatically slow down to try to improve the framerate."
		FpsTarget0 = "Disabled"
		FpsTarget30 = "30 F.P.S."
		FpsTarget60 = "60 F.P.S."
		FpsTargetWarning = "<s14><bad><b>WARNING:</b> Using a Minimum Target F.P.S. of 60 while VSync is also enabled can cause performance issues. "\
		                   "We recommend that you use one or the other but not both.</bad></s14>"

		LimitFps = "Ogranicz Liczbę Klatek Na Sekundę"
		LimitFpsTip = "Jeśli zaznaczone, ilość FPS-ów nie przekroczy podanej wartości."
		LimitFpsUnfocusedTip = "If checked, the game will not run any faster than a particular framerate while running in the background."
		LimitFpsNumber = " Klatki Na Sekunde"
		LimitFpsNumberTip = "Maksymalna liczba klatek renderowanych w ciągu sekundy."

		AnimateBackgrounds = "Animacje Tła"
		AnimateBackgroundsTip = "Jeśli włączone, tło gry będzie animowane. Wyłączenie tego parametru może znacznie zwiększyć wydajność gry."

		FancyLighting = "Fancy Lighting Effects"
		FancyLightingTip = "If enabled, additional lighting effects will be rendered. Turning this off can improve performance."

		FancyParticles = "Ładne Cząsteczki i Efekty Wizualne"
		FancyParticlesTip = "Jeśli włączone, dodatkowe efekty cząsteczkowe oraz efekty wizualne będą renderowane. Wyłączenie tego parametru może zwiększyć wydajność gry."

		FancyUIEffects = "Fancy U.I. Effects"
		FancyUIEffectsTip = "if enabled, additional user interface effects such as the \"glass\" blur will be rendered. Turning this off can improve performance."

		FancyNebulas = "Fancy Clouds & Storms"
		FancyNebulasTip = "If enabled, clouds and storms will have lighting and animation. Turning this off can improve performance."

		UncompressedTextures = "Używaj Nieskompresowanych Tekstur"
		UncompressedTexturesTip = "Jeśli włączone tekstury nie będą kompresowane. Włączenie tej opcji może bardzo nieznaczmie zwiększyć jakość tekstur i mocno zwiększyć zużycir RAM-u/VRAM-u. "\
		                          "Zmienienie tej opcji wymaga restartu gry."

		ScreenShake = "Wstrząsy Ekranu"
		ScreenShakeTip = "Jeśli zaznaczone, niektóre wydarzenia w grze takie jak np. eksplozje będą powodować wstrząsy ekranu."

		UIAnimations = "U.I. Animations"
		UIAnimationsTip = "If enabled, then the user interface will animate in response to user input."

		BackgroundGrid = "Background Grid"
		BackgroundGridTip = "Whether and what style of background grid that will be displayed in the background to make it easier to judge distances and speeds."
		BackgroundGridCrosses = "Crosses"
		BackgroundGridLines = "Lines"
		BackgroundGridOff = "Off"

		PostShader = "Post Shader"
		PostShaderTip = "Fun post-processing shaders that make the game look different! Try them out!"
	}

