	DistributePower_On = "<b>Thruster Power Distribution: <good>On</good></b>\n\nHotkey: <btn id='PartToggles.distribute_power_on'/>"

	Lights_Low = "<b>Lights: Low</b>\n\nHotkey: <btn id='PartToggles.lights_low'/>"
	Lights_Med = "<b>Lights: Medium</b>\n\nHotkey: <btn id='PartToggles.lights_med'/>"
	Lights_High = "<b>Lights: High</b>\n\nHotkey: <btn id='PartToggles.lights_high'/>"

	Boost_Off = "<b>Boost: <bad>Off</bad></b>\n\nHotkey: <btn id='PartToggles.thruster_boost_off'/>"
	Boost_On = "<b>Boost: <good>On</good></b>\n\nHotkey: <btn id='PartToggles.thruster_boost_on'/>"

	MissileType_HE = "<b><string id='MissileTypes/HE'/></b>\n\n<string id='MissileTypes/HEDesc'/>\n\nHotkey: <btn id='PartToggles.missile_type_he'/>"
	MissileType_EMP = "<b><string id='MissileTypes/EMP'/></b>\n\n<string id='MissileTypes/EMPDesc'/>\n\nHotkey: <btn id='PartToggles.missile_type_emp'/>"
	MissileType_Nuke = "<b><string id='MissileTypes/Nuke'/></b>\n\n<string id='MissileTypes/NukeDesc'/>\n\nHotkey: <btn id='PartToggles.missile_type_nuke'/>"
	MissileType_Mine = "<b><string id='MissileTypes/Mine'/></b>\n\n<string id='MissileTypes/MineDesc'/>\n\nHotkey: <btn id='PartToggles.missile_type_mine'/>"
	MissileType_Thermal = "<b><string id='MissileTypes/Thermal'/></b>\n\n<string id='MissileTypes/ThermalDesc'/>\n\nHotkey: <btn id='PartToggles.missile_type_thermal'/>"

	LaunchMines = "Launch Mines\n\nHotkey: <btn id='PartToggles.launch_mines_on'/>"
	ForceStartChaingun = "Force Fire Chaingun\n\nHotkey: <btn id='PartToggles.force_fire_chaingun_on'/>"

	TractorMode_Auto = "<b>Tractor Beam: Auto</b>\n\nThe Tractor Beam will automatically push or pull to keep the target at the current distance.\n\nHotkey: <btn id='PartToggles.tractor_mode_auto'/>"
	TractorMode_Pull = "<b>Tractor Beam: Pull</b>\n\nThe Tractor Beam will pull the target as close as possible.\n\nHotkey: <btn id='PartToggles.tractor_mode_pull'/>"
	TractorMode_Push = "<b>Tractor Beam: Push</b>\n\nThe Tractor Beam will push the target as far away as possible.\n\nHotkey: <btn id='PartToggles.tractor_mode_push'/>"

	TractorOverload = "<b>Overload Tractor Beam</b>\n\nExpend all available power to overload the emitters, triggering an uncontrolled extreme impulse wave and a significant release of heat.\n\n" \
					  "Setting the Tractor Beam to 'Pull' will invert the polarity of the impulse wave."

	FireSafety_Off = "<b>Safety: <bad>Off</bad></b>\nDo not prevent firing regardless of heat levels."
	FireSafety_On = "<b>Safety: <good>On</good></b>\nPrevent firing while at dangerously high heat levels."

	ThermalOverclock_Off = "<b>Overclock: <good>Off</good></b>\nOperate normally, adhering to the part's intended limits."
	ThermalOverclock_On = "<b>Overclock: <bad>On</bad></b>\nBypass limiters and exceed operational ratings, increasing performance at the cost of heat generation and unreliability."

	OverclockShield_Extended = "<b>Shield Overclock Mode: <good>Extended</good></b>\nIncreases the shield arc and projection distance by routing additional power to the shield's core."
	OverclockShield_Reinforced = "<b>Shield Overclock Mode: <good>Reinforced</good></b>\nHardens the shield against damage and energy draining effects by routing power from the peripheral to central emitters."
}

