		Welcome = "<b>Welcome to Cosmoteer!</b>"
		Tutorials = "As you play for the first time, tutorials like this one will appear near the <white>top-left corner of the screen</white>. These will teach you how to play Cosmoteer one step at a time. To read a tutorial, simply <white>click on it</white>. To skip a tutorial, click the little red <bad>X</bad> next to it."
		Codex = "<good>TIP:</good> All tutorials can be re-read at any time by selecting <white>\"Tutorials &amp; Codex\"</white> from the pause menu. (<btn id='General.Cancel'/> key)"
	}

	Camera
	{
		Title = "Controlling the Camera"
		EdgePan = "To <good>pan the camera</good>, move the <white>mouse cursor</white> to the edge of the screen or use the <white>arrow or W.A.S.D. keys</white>."
		Zoom = "To <good>zoom in and out</good>, use the <white>scroll wheel</white> on your mouse or press the <btn id='View.ZoomIn'/> and <btn id='View.ZoomOut'/> keys."
		Tip = "<good>TIP:</good> Can't find your ship? Click its icon in the lower-left corner or press the <btn id='View.FocusSelected'/> (Focus) key."
	}

	Movement
	{
		Title = "Flying Your Ship"
		Move = "To <good>fly your starship</good>, <white>right-click</white> anywhere in space. Your ship will fly there automatically."
	}

	Time
	{
		Title = "Controlling Time"
		Buttons = "To <good>pause the game</good> at any time, click the <white>||</white> button near the center-top of the screen, or press the <btn id='Game.PauseToggle'/> key."
		Faster = "To make time <good>go faster</good> or <good>slower</good>, click the <white>&gt;&gt;</white> or <white>&lt;&lt;</white> buttons."
		Tip = "<good>TIP:</good> If you're ever having trouble clicking on something because it's moving too fast, just press <btn id='Game.PauseToggle'/> to pause the game."
	}

	Comms
	{
		Title = "Hailing Ships & Stations"
		Interact = "You can interact with some other ships and stations by <good>hailing</good> (calling) them."
		CommsButton = "To <good>hail a ship or station</good>, first click the <white>Comms</white> button near the lower-left."
		HailButton = "Then click the <white>HAIL</white> button next to the ship or station you want to call, or simply <white>click on it</white> if it is within view. <bad>Try hailing the nearby friendly station.</bad>"
		Stations = "Friendly <good>stations provide various services</good> such as a <white>mission list</white>, <white>crew hiring</white>, and <white>resource trading</white>. These services will be explained in more detail later."
		Note = "<good>NOTE:</good> Not all ships and stations will accept your hailing requests or offer all types of services."
	}

	Missions
	{
		Title = "Missions"
		Info = "Missions are your primary way of earning <money>CREDITS</money> and <fame>FAME</fame>."
		Stations = "Most friendly stations will have a <good>mission board</good> advertising the available missions. <bad>If you haven't already, hail the nearby friendly station to view its mission board.</bad>"
		DangerLevel = "Most missions have a <good>\"danger level\"</good> such as <gray>[</gray><good>1</good><gray>]</gray> that indicates approximately how challenging it will be. You will want to upgrade your ship before tackling higher-level missions."
		Accept = "To <good>accept a mission</good>, select it from the list on the left and then click the <white>Accept</white> button."
		Tip = "<good>TIP:</good> We recommend you accept the first level <gray>[</gray><good>1</good><gray>]</gray> Fugitive Bounty mission. Stay away from higher-level missions until you have upgraded your ship."
	}

	Missions2
	{
		Title = "Missions (Continued)"
		Tracked = "<good>Nearby missions</good> will be automatically \"tracked\" near the top-left of the screen."
		Location = "Many missions will also <good>show the location</good> where you'll need to fly in order to complete its objectives. (You may need to zoom out to see it.) <white>Click on an objective</white> to center the camera on its location."
		MissionLog = "You can <good>view all of your current missions</good> by clicking on the <white>Career Log</white> button near the top-left of the screen."
		Try = "<bad>Try flying your ship to the mission's location.</bad>"
	}

	Combat
	{
		Title = "Attacking the Enemy"
		Detected = "An enemy ship has been detected nearby!"
		Blips = "Nieprzyjacielskie statki które są za daleko by je bezpośrednio zobaczyć, ale są wykryte przez radar, będą widoczne jako pulsujące <red>sygnały na radarze</red>."
		Attack = "To <good>attack an enemy</good> starship, <white>right-click</white> on it or on its radar blip. Your ship will fly to it and attack. (The game may have automatically paused to show you this tutorial. Press <btn id='Game.PauseToggle'/> to unpause.)"
		Tip = "<good>TIP:</good> Some enemy ships will be too powerful for you to defeat! Flee and <good>upgrade</good> your ship before attacking them."
	}

	Tactics
	{
		Title = "Combat Tactics"
		Target = "After attacking an enemy, <white>right-click</white> again on a particular part of the enemy ship to <good>target</good> your weapons on it."
		Reactor = "<good>TIP:</good> Destroy the enemy starship's <good>reactor or command room</good> to turn it into a lifeless husk!"
	}

	Salvaging
	{
		Title = "Gathering & Salvaging Materials"
		DestroyedShips = "Destroyed ships will drop <good>valuable materials</good> which you can use to <good>repair and upgrade</good> your own ship. Any remaining pieces of destroyed ships can also be salvaged for additional materials."
		GatherSalvage = "To <good>collect and salvage</good> those materials, click the <white>Gather/Salvage/Mine</white> button near the bottom-left and then drag a box around everything you want to collect and salvage. Your ship's crew will automatically collect the materials and store them in your ship."
		WholeShip = "<white>Click without dragging</white> on a defeated ship to move your own ship to it and salvage the whole thing."
		RecallCrew = "In an emergency, press the <white>Recall Crew</white> button to cancel all crew orders and <good>summon everyone back</good> to your ship."
		Tip = "<good>TIP:</good> If gathering &amp; salvaging are taking too long, try using the <white>&gt;&gt;</white> button to increase the game speed."
	}

	Repairs
	{
		Title = "Repairing Your Ship"
		Button = "When your ship needs repairs, a red <white>Repair</white> button in the lower left will appear. Click it to <good>open build/repair mode</good>."
		Parts = "To <good>repair a single part</good> that is damaged or destroyed, <white>left-click</white> on it.\n\nYour crew will automatically exit the ship to perform the repairs."
		Caution = "<bad>CAUTION:</bad> Your crew will be very vulnerable while outside your ship! Only repair when safe!"
		RepairAll = "To <good>repair your whole ship</good>, click the <white>Repair All</white> button in the bottom-right corner of the screen."
		Materials = "<good>Repairing uses materials.</good> If you don't have enough then you might not be able to repair everything until you gather or buy more."
		Exit = "When you're done repairing, click the red <bad>X</bad> button or press <btn id='General.Cancel'/> to exit build/repair mode."
	}

	Missions3
	{
		Title = "Getting Paid"
		Return = "After completing all of a mission's objectives, you will usually have to <good>return to the original station</good> to get paid."
		Hail = "Once you have arrived back at the station, <good>hail it again</good>."
		ReceiveRewards = "You should then see a list of any completed missions you can get paid for. <good>To get paid</good>, click on the mission and then click the <white>Receive Payment</white> button."
	}

	Build
	{
		Title = "Upgrading Your Ship"
		Button = "To <good>upgrade your ship</good>, click the <white>Build</white> button in the lower left. (You can't upgrade your ship while under fire from enemy ships.)"
		Parts = "To <good>add a part</good> to your ship, <white>select it</white> in the box below. Then <white>left-click</white> on your ship where you want to add it."
		Crew = "Your crew will automatically exit your ship to make the modifications."
		Caution = "<bad>CAUTION:</bad> Your crew will be very vulnerable while outside your ship! Only upgrade when safe!"
		Rotate = "To <good>rotate a part</good> before adding it, press the rotation buttons or <white>right-click</white>."
	}

	Build2
	{
		Title = "Upgrading Your Ship (Continued)"
		Materials = "Like repairing, <good>construction uses materials</good>. If you don't have enough then the additional materials will be <good>automatically purchased</good> from any nearby station if you have the <money>CREDITS</money> and the station has the materials in stock."
		Grab = "To <good>pick up a part</good> and move it somewhere else, use the <white>Grab</white> tool."		Delete = "To <good>remove a part</good> from your ship, use the <white>Delete</white> tool. You will receive a full refund of all materials used to build it."
		Tip = "<good>TIP:</good> Made a mistake? Just click the <white>Undo</white> button or press <btn id='Design.Undo'/>."
		Close = "When you're finished upgrading your ship, click the red <bad>X</bad> button or press <btn id='General.Cancel'/> to exit build mode."
	}

	Crew
	{
		Title = "Your Ship's Crew"
		InteriorButton = "To <good>view the inside</good> of your ship, click the <white>interior toggle</white> button."
		Crew = "<good>Crew</good> operate your ship by manning weapons, piloting, and carrying supplies. The more crew a ship has, the more effectively it can function!"
		Indicator = "Część która nie ma żadnej załogi do jej obsługi będzie miała <red>czerwoną ikonę załogi</red>."
		PathLines = "When building, pay attention to how far a room is from the crew, power, or munitions it needs. Farther distances mean power and munitions will be delivered more slowly. The <good>green</good> path lines will turn <yellow>yellow</yellow> and then <bad>red</bad> if farther than recommended."
	}

	Fame
	{
		Title = "Becoming Famous"
		Fame = "Your current <fame>FAME</fame> is displayed in the top-right corner underneath your <money>CREDITS</money>."
		IncreasingFame = "As you <good>defeat enemies</good> and <good>complete missions</good>, your <fame>FAME</fame> will increase. It will never decrease."
		FameCrew = "And as your <fame>FAME</fame> increases, more people will want to join your crew! More crew is always better!"
		Tip = "<good>TIP:</good> As you become more famous, you will soon stop earning fame from lower-level ships and missions. Defeat and complete higher-level ships and missions to keep increasing your <fame>FAME</fame>."
	}

	Crew2
	{
		Title = "Hiring Crew"
		Button = "Before you can hire more crew, you'll need to <good>build more beds</good>. Start by clicking the <white>Build</white> button again."
		Quarters = "Add a <white>Crew's Bunk</white> or <white>Crew's Quarters</white> to increase the <good>maximum number of crew</good> you can have on your ship."
		Door = "You'll also want <white>doors</white> so that your crew can <good>walk between rooms</good>."
		Airlock = "<white>Airlocks</white> allow your crew to <good>enter and exit</good> your ship when salvaging, mining, and transferring resources."
		Meter = "The <good>crew meter</good> displays the number of crew on your ship, and the <good>vertical green bar</good> indicates the recommended amount."
	}

	Crew3
	{
		Title = "Hiring Crew (Continued)"
		Hail = "To <good>hire more crew</good>, hail a nearby station and then click the <white>Hire Crew</white> tab."
		List = "A list of everyone <good>willing to join</good> your crew will be displayed. Increase your <fame>FAME</fame> to persuade more."
		Hire = "To <good>hire an individual</good>, click their <white>Hire</white> button, or click the <white>Hire Max</white> button to hire <good>as many as possible</good>. You will pay a one-time fee in <money>CREDITS</money> for each crew hired."
		Warning = "<bad>WARNING:</bad> Be careful not to fly away before the crew you hire are able to fly to and board your ship!"
		Tip1 = "<good>TIP:</good> The hiring fee increases as your crew grows and decreases as your fame grows, so you can save <money>CREDITS</money> by waiting to hire until you have more <fame>FAME</fame>."
		Tip2 = "<good>TIP:</good> All crew have the same abilities and are equally good at all jobs, so hire whoever you want!"
	}

	Power
	{
		Title = "Powering Your Ship"
		Reactor = "<good>Reactors</good> generate the plasma batteries for your ship's thrusters, energy weapons, and other parts."
		Crew = "Your <good>crew</good> will carry plasma batteries from the <white>Reactor</white> or <white>Power Capacitor</white> to your ship's parts."
		Meter = "The <good>power meter</good> displays the total amount of power generated by your reactors, and the <good>vertical green bar</good> displays the recommended amount."
		Indicator = "A part that doesn't have enough power to operate will have a <red>red icon</red>. This is usually because there aren't enough crew to carry batteries or it's too far from a power source, but it can also happen if your ship's reactors aren't generating enough batteries."
		Tip = "<good>TIP:</good> How often an energy weapon can shoot depends on how quickly crew can deliver power to it."
	}

	Resources
	{
		Title = "Resources"
		Resources = "<good>Resources</good> are valuable and have many uses:"
		Materials = "<good>Construction materials</good>, such as <white>Steel</white> and <white>Coils</white>, are used to repair and upgrade ships. They are typically salvaged from defeated enemies or bought at stations."
		Munitions = "<good>Munitions</good>, such as <white>cannon ammo</white>, are used by certain weapons. They are typically produced in factories or bought from stations."
		Elements = "<good>Raw elements</good>, such as <white>Iron</white> and <white>Copper</white>, are used in factories to produce construction materials and munitions. They are typically mined from asteroids."
		Storage = "Resources are stored in <good>Storage Bays</good>. Build more Storage Bays to increase how many resources your ship can hold."
		Trade = "Resources can be <good>bought and sold</good> at stations by hailing the station and selecting the <white>Trade</white> tab. (More valuable resources may often be out-of-stock.)"
	}

	Mining
	{
		Title = "Mining Asteroids"
		Asteroids = "While exploring, you will often find asteroids containing valuable <good>resource deposits</good>."
		Mine = "To <good>mine those asteroids</good>, click the <white>Gather/Salvage/Mine</white> button and then click on the asteroid you want to mine. Your ship's crew will automatically mine the resources and store them in your ship."
		Icon = "<good>When zoomed out</good>, the appropriate chemical element symbol will be displayed over any asteroids with untapped resource deposits."
		Tip = "<good>TIP:</good> Many resource deposits will be stuck in rock that is too hard for crew to extract. Build a <good>Mining Laser</good> to extract those resources."
	}

	Camera2
	{
		Title = "Controlling the Camera (Advanced)"
		Drag = "To <good>drag the camera</good>, click, hold, and then drag the <white>middle mouse button</white>."
		FocusClick = "To <good>focus the camera</good> on any ship, click the <white>middle mouse button</white> on it.\n\nYou can also <white>middle-click</white> in empty space to center the camera there."
		AltDrag = "To <good>focus on multiple ships</good>, hold the <btn id='View.FocusCursorMode'/> key, <white>left click</white>, and drag a box around the ships."
		Tip = "<good>TIP:</good> Press the <btn id='View.FocusSelected'/> key to focus on your ship."
	}

	Techs
	{
		Title = "Acquiring Blueprints"
		Blueprints = "Many weapons and other ship parts <good>cannot be constructed</good> until you acquire the necessary blueprints."
		Purchase = "To buy blueprints, hail a space station and select the <white>Purchase Blueprints</white> tab."
		Permanent = "Buying a blueprint <good>permanently unlocks</good> the ability to construct that type of part."
	}

	Thrusters
	{
		Title = "Thrusters"
		Thruster = "Add <good>thrusters</good> to increase your ship's speed and maneuverability. A ship with too few thrusters cannot fly."
		Many = "Thrusters propel your ship in their opposite direction.\n\nThe speed and maneuverability of your ship depends on the number, location, orientation, and size of its thrusters."
		Tip = "<good>TIP:</good> A speedy and maneuverable starship has many thrusters in a variety of locations and orientations."
	}

	Paint
	{
		Title = "Painting Your Ship"
		Button = "To <good>paint your ship's exterior</good>, click the <white>Paint</white> button in the lower left."
		ColorWheel = "From here you can change your ship's <good>base paint color</good> and <good>pattern</good>."
		Decals = "You can also paint <good>decals</good> onto your ship.\n\nA ship can have up to three layers of decals. Each layer can have a different color, and all decals within a layer share that color."
		Tip = "<good>TIP:</good> Painting your ship is free and has no effect on its capabilities. Go wild!"
	}

	Ftl
	{
		Title = "Hyperdrives"
		BuildFtl = "Construct a <good>Hyperdrive</good> to enable hyperspace jumps within the star system and even to other star systems. (You will first need to purchase its blueprints from a space station.)"
		PlotJump = "Once constructed, click the <white>Hyper-Jump</white> button and choose a destination. Your crew will power up your Hyperdrive and then your ship will jump."
		Valid = "While choosing where to jump, <good>valid destinations will pulse blue</good>. You can jump to any station, hyper-jump beacon, or hyper-jump gate that you have already discovered."
		Hyperium = "Jumping uses a number of <good>Hyperium</good> crystals depending on the distance of the jump, the size of your ship, and its Hyperdrive Efficiency. Hyperium can be mined from asteroids, salvaged from enemies, or bought from stations."
		Tip = "<good>TIP:</good> Larger ships with only one Hyperdrive will have a very low Hyperdrive Efficiency. Add more Hyperdrives spread evenly across it to increase efficiency and jump longer distances for less Hyperium."
	}

	Micro
	{
		Title = "Micromanaging Your Ship"
		Select = "<white>Left-click</white> on an individual part to <good>select</good> it.\n\nYou can also shift-click on or drag a box around multiple parts."
		Power = "Press the <white>Power</white> button to <good>turn it off</good>. Any crew operating the part will leave and help out elsewhere."
		FireMode = "Press the <white>Fire Mode</white> button to tell a weapon to <good>hold fire</good>, <good>only fire at its given target</good>, or <good>fire infinitely</good> as you see fit."
		Target = "With a weapon selected, <white>right-click</white> on an enemy part to <good>target</good> the weapon on it."
		ControlGroups = "<good>TIP:</good> Create a <good>control group</good> by selecting one or more parts and then pressing <white>Ctrl + 0-9</white>. Select that group by pressing <white>0-9</white>."
	}

	Build3
	{
		Title = "Advanced Ship Design"
		Brush = "With a 1-tile part selected, you can choose between <good>different brushes</good> of various shapes and sizes."
		MirrorMode = "Enable <good>mirror mode</good> to quickly create symmetrical ship designs. <white>Right-click</white> this button for more options."
		SelectCopyPaste = "Use the <good>selection tool</good> to copy, paste, mirror, rotate, or delete entire sections of your ship."
		Button = "To modify your ship's <good>blueprints</good>, click the <white>Toggle Blueprints</white> button."
		Ship = "Use blueprints to make <good>temporary changes</good> to your design that would otherwise be illegal, and to experiment before spending any resources or <money>CREDITS</money>."
		Commit = "When you're satisfied with your design, click the <white>MAKE IT SO</white> button. Your ship will be updated and the cost will be deducted from your resources and <money>CREDITS</money>."
	}

	Movement2
	{
		Title = "Flying Your Ship (Advanced)"
		Drag = "To <good>adjust the orientation</good> of your ship, <white>right-click</white> and <white>drag</white>."
		Queue = "To <good>add waypoints</good>, hold <btn id='Game.AppendSelection'/> while right-clicking."
		Handles = "To <good>move or rotate</good> existing waypoints, hold <btn id='Game.AppendSelection'/> and then drag one of the handles that appear.\n\nTo <good>delete</good> a waypoint, click the <white>trash can</white> icon."
	}

	Tactics2
	{
		Title = "Combat Tactics (Advanced)"
		Drag = "To choose the <good>distance</good> and <good>direction</good> to attack from, <white>right-click</white> on the enemy ship and <white>drag</white> away from it."
		Handles = "To adjust the <good>distance</good>, <good>direction</good>, or <good>rotation</good> after attacking, hold <btn id='Game.AppendSelection'/> and then drag one of the handles that appear."
		TargetQueue = "To <good>queue additional targets</good>, hold <btn id='Game.AppendSelection'/> while right-clicking on the parts."
	}

	AdvancedCommands
	{
		Title = "Advanced Ship Controls"
		Info = "In the lower-left corner are a handful of commands that give you greater control of your ship:"
		Move = "The <good>Move Command</good> (<btn id='Game.Move'/>) allows you to move to a specific location or follow any ship."
		Attack = "The <good>Attack Command</good> (<btn id='Game.Attack'/>) allows you to attack almost any ship, even your own or other friendly ships. "\
		         "You can also use it to quickly adjust the angle and distance of an existing attack order."
		Halt = "The <good>Halt Command</good> (<btn id='Game.Halt'/>) cancels all current orders."
		Rotate = "The <good>Rotate Command</good> (<btn id='Game.Rotate'/>) rotates your ship in place without moving."
		Strafe = "The <good>Strafe Command</good> (<btn id='Game.Strafe'/>) moves your ship while keeping its current rotation."
		DirectControl = "If you prefer to <good>fly your ship manually</good> using the keyboard and mouse, click the <white>Direct Control Mode</white> button."
	}

	Crew4
	{
		Title = "Crew Squads & Roles"
		Autonomous = "<good>Crew are mostly autonomous</good> and will operate your ship on their own, but you can still customize their behavior if you want to."
		Button = "To <good>customize your crew's behavior</good>, click the <white>Manage Crew</white> button."
		Roles = "Every ship has one or more <good>\"Roles\"</good> which determine how its crew behave."
		AddRole = "To <good>add a new role</good>, click the large <white>New Role</white> button."
		EditRole = "To <good>edit a role's</good> name, color, and job priorities, <btn id='General.UIAltClick'/> on it and select \"Edit Role\"."
		Priorities = "Most ship parts have one or more jobs associated with them, each with <good>a priority between 1 and 10</good> that can be customized for each different role."
		Priorities2 = "A job with a <good>higher</good> priority number will always be done <good>before</good> a job with a <good>lower</good> priority number. "\
		              "You can also disable a job completely to prevent crew with that role from ever doing that job."
	}

	Crew5
	{
		Title = "Crew Squads & Roles (Continued)"
		Squads = "<good>Crew are organized into \"Squads\".</good> Each squad has its own bedroom where its members will return when they have nothing to do."
		AssigningCrew = "To <good>assign crew to a squad</good>, <white>left-click</white> on or drag a box around the crew and then <white>right-click</white> on the desired squad bedroom."
		SquadRoles = "<good>Every squad is assigned a role.</good> To assign a role to a squad, click the button for the desired role and then click on the bedrooms of any squads that should use that role."
	}

	Crew6
	{
		Title = "Crew Squad Orders"
		Tell = "You can also tell specific crew squads to <good>only do jobs for specific weapons or other parts</good>."
		OrdersMode = "Open the <white>Crew Management</white> screen and then switch on <white>Order Squads Mode</white>."
		Order = "<white>Left-click</white> on or drag a box around any squad bedrooms you want to order and then <white>right-click</white> on any weapons or other parts you want to assign them to."
		Never = "<bad>Be careful! If a squad has any orders then it will NEVER do jobs for any other parts!</bad>"
		Tip = "<good>TIP:</good> If you notice some crew not doing anything when you think they should, double-check their squad's orders!"
	}

	Resources2
	{
		Title = "Resource Management"
		Manage = "To manage your ships resources, click the <white>Manage Resources</white> button."
		Stacks = "Most resources are stored in <good>stacks</good> on <good>storage tiles</good>. Zatoka Magazynowas can hold stacks of any type. Weapons, factories, and other specialized parts can only hold resources that they actually use or produce."
		Move = "To tell your crew to <good>move resources</good> from one tile to another, select the <white>Move Resources</white> tool, click the stack of resources you want to move, and then click the tile where they should be moved."
		Designate = "You can also tell your crew to store <good>only a specific resource</good> in specific tiles. Click the button for the desired resource and then click on the tiles that should only store that resource. Your crew will try to store that resource in those tiles whenever possible and will not automatically store other resources in them."
		Limits = "To <good>limit the quantity</good> of a resource stored on your ship, open the <img name='hamburger_up'/> menu and then select <white>Resource Desires &amp; Limits</white>."
		SupplyChains = "Lastly, you can also set up <good>supply chains</good> between storages, factories, reactors, weapons, and other parts. This works very similarly to crew squad orders: When a supply link is added, the supplier and receiver will never send resources to or receive resources from any other parts."
	}

	Ftl2
	{
		Title = "Hyper-Jump Relays"
		Relays = "<good>Hyper-Jump Relays</good> allow any ship with a Hyperdrive and enough <img name='resource.hyperium'/>Hyperium to travel to other star systems."
		GalaxyMap = "Click the <white>Galaxy Map</white> button to view a map of the whole galaxy."
		Numbers = "The numbers such as <gray>[<good>1</good>-<good>3</good>]</gray> next to the name of each star system indicate the expected level of danger. Expect <bad>extreme difficulty</bad> when traveling to a system that you aren't prepared for."
		PlotJump = "To <good>travel to another system</good>, click <white>Plot Hyper-Jump</white> and then click on the destination system. Like jumping within a system, jumping to another system uses a number of <img name='resource.hyperium'/>Hyperium depending on the length of the jump, the size of your ship, and its Hyperdrive Efficiency."
		ExitMap = "Exit the galaxy map, and the Hyper-Jump Relay that you should use will now be <good>highlighted</good> for you. <white>Right-click</white> on it to fly to it. Once there, your crew will automatically power up your Hyperdrive."
		Engage = "When you're ready to jump, simply click the <white>ENGAGE</white> button."
	}

	CommandPoints
	{
		Title = "Command Points"
		CommandRooms = "The <white>Cockpit</white>, <white>Control Room</white>, and <white>Bridge</white> each provide a certain number of <good><img name='command_points' colored='true'/>Command Points</good>, as shown in the top-right corner of each room's icon."
		UsingPoints = "Most weapons and other systems <good>use command points</good> as shown in the top-right corner of each icon."
		PointsRemaining = "The number of <good>command points remaining</good> is displayed on the right. Once you run out, you won't be able to add new weapons or other systems until you add or upgrade command rooms."
		Tip = "<good>TIP:</good> If a command room is destroyed or becomes unpowered, you will lose the command points it provides, and if your ship no longer has enough command points, you will lose complete control of it. To regain control, repair the command room or power off the individual systems until you have enough command points."
	}

	Cannons
	{
		Title = "Cannons & Ammo"
		Cannon = "<good>Cannons</good> (and <good>Railguns</good>) are projectile weapons that use <good>ammunition</good> instead of power."
		Factory = "Ammunition can be <good>bought</good> cheaply at stations or <good>manufactured</good> from <img name='resource.sulfur'/>Sulfur in an Ammo Factory."
		Crew = "Your <good>crew</good> will carry ammo from your storages or factories to your cannons."
		Tip = "<good>TIP:</good> How often a cannon can shoot depends on how quickly crew can deliver ammo to it."
	}

	Missiles
	{
		Title = "Missiles & Mines"
		Launcher = "The <good>Launcher</good> is a versatile weapon that can fire <good>munitions</good> of various types, such as missiles and mines."
		ChangeType = "To <good>change the type of munition</good> it fires, select the Launcher and then click the <white>munition type</white> button."
		Tip = "<good>TIP:</good> The Launcher's munition type can be changed at any time during or after construction, even during battle!"
	}

	IonBeams
	{
		Title = "Ion Beams & Prisms"
		IonBeams = "<good>Ion Beams</good> are fixed-direction energy beam weapons that can't aim but deal high, continuous damage over time."
		IonPrisms = "But if you place an <good>Ion Prism</good> in front of an Ion Beam, it can redirect the beam in any direction, such as at an enemy ship or even into another Ion Prism."
		Combining = "Multiple <good>beams can be combined</good> into a single Prism, creating a single larger, more-powerful beam."
		Aiming = "To <good>aim a Prism</good>, first exit build mode, select the Prism, and then click the <white>Aim Ion Prism</white> button."
		Tip = "<good>TIP:</good> Combining multiple beams together lowers their total damage output. To maximize the damage of a single beam, always combine exactly two equal-sized beams per prism."
	}

	Railguns
	{
		Title = "Railguns"
		Info = "Railguns are <good>modular</good>, <good>custom-length</good> projectile weapons constructed out of multiple parts. The longer the railgun, the more damage it will do and the longer its range will be."
		Launcher = "Every Railgun requires a <good>Launcher</good> module on the forward end, which shoots out projectiles at high velocity."
		Accelerator = "Railguns can also have any number of optional <good>Accelerator</good> modules. Each Accelerator increases the range, damage, and penetration depth of the projectile."
		Loader = "And lastly, every Railgun requires a <good>Loader</good> module at the aft end, which is where the projectile ammunition is loaded by the crew."
		Tip = "<good>TIP:</good> Each Launcher and Accelerator module must be individually powered by batteries delivered by crew. If a single Launcher or Accelerator module is not powered, the entire Railgun will be unable to fire. (The Loader module only requires standard cannon ammunition and does not need to be powered.)"
	}

	Chainguns
	{
		Title = "Chainguns"
		Info = "Chainguns are rotary projectile weapons that <good>increase their rate of fire as they shoot</good>. The longer the Chaingun is firing, the faster it will shoot, up to a limit."
		Shell = "While not shooting, Chainguns <good>hide behind a protective shell</good> that greatly reduces incoming damage."
		Magazines = "<good>Ammunition Magazines</good> can be attached to expand their ammo storage, which will increase how long they can keep shooting at maximum speed. Magazines must be attached to the rear left or right sides of the chaingun. (See picture.)"
		ForceFire = "Chainguns will normally <b>not</b> start shooting until the Chaingun itself and all of its magazines are full of ammo. To force a Chaingun to start firing before it's full, click the <white>Force Fire</white> button."
	}

	AbandonedShips
	{
		Title = "Abandoned Ships"
		Discover = "Occasionally you may discover ships that have been <good>abandoned</good> by their crews.\n\n"\
		           "These ships can be <good>salvaged for resources</good> like any junk, but you can also <good>take control</good> of them and add them to your fleet."
		Transfer = "To <good>take control</good> of an abandoned ship, click the little <img name='hamburger_up'/> button and select the <white>Transfer Crew</white> option."
		Dialog = "Then, <good>choose how many crew</good> you want to transfer to the abandoned ship. (You may have to select the desired ship from the dropdown on the right if you already have more than one ship or there are multiple abandoned ships nearby.)"
		StartTransfer = "Click the <white>Initiate Transfer</white> button to send your crew. Once your crew arrive at the ship, they will take control of it!"
	}

	Fleets
	{
		Title = "Commanding Your Fleet"
		Selected = "When you have more than one ship, <b>left-click</b> on the ship you want to <good>control</good>.\n\n"\
		           "The controlled ship has a <good>green indicator</good> around it."
		BoxSelect = "To <good>control multiple ships</good> at once, <b>left-click and drag</b> a box around the ships.\n\nOr, hold <btn id='Game.AppendSelection'/> and <b>left-click</b> on each ship."
		Synchronize = "When ordering multiple ships to move at the same time, they will <good>synchronize their speeds</good>. Faster ships will slow down to match the speed of the slowest ship. (<b>Double-right-click</b> to disable speed synchronization.)"
		ControlGroups = "<good>TIP:</good> Create a <good>control group</good> by selecting one or more ships and then pressing <b>Ctrl + F1-F8</b>. Select that group by pressing <b>F1-F8</b>."
	}

	Formations
	{
		Title = "Formations"
		BasicFormations = "To tell your ships to <good>fly in formation</good>, select at least two ships, click on the <white>Formations</white> button, and then select a formation to use."
		CustomFormations = "To create a <good>custom formation</good>, select a ship and then position it near another ship by <white>right-clicking</white> on the other ship, holding the mouse button, and <white>dragging away from it</white>."
		SavingFormations = "To <good>save a custom formation</good>, click the little arrow and then click a <white>SAVE</white> button to save the formation in an empty formation slot."
	}

	Fires
	{
		Title = "Fires"
		Cause = "<red>Fires</red> can break out when hit by certain weapons, when volatile parts explode, or when the ship's hull is very hot. Left unattended, "\
		        "fires will quickly grow and spread, causing damage, killing crew, and eventually <red>scorching</red> parts, which renders them inoperable until repaired."
		FireExtinguisher = "Add <good>fire extinguishers</good> to your ship to help fight fires. Your crew will pick up "\
		                   "fire extinguishers and use them to put out fires. Each fire extinguisher has a limited capacity, so multiple extinguishers may be required to put out large fires."
		Spread = "<good>TIP:</good> Fires can spread through open areas and through doors, but not through walls. "\
		         "Adding a lot of doors to your ship will make it more vulnerable to fires."
	}

	Scorched
	{
		Title = "Scorched Parts"
		CauseAndEffect = "After burning for long enough, a part will become <red>scorched</red>. Scorched parts will no longer function and will slow the movement of crew."
		Solution = "The part's functionality can be restored by repairing it to full health."
	}

	Heat
	{
		Title = "Hull Heat"
		Cause = "A ship's hull can <orange>heat up</orange> when hit with thermal weaponry, or when certain parts produce <orange>waste heat</orange> with nowhere to store or exhaust it."
		Effect = "As the hull gets hotter, it becomes more vulnerable to damage and penetration, will begin to catch on fire, and then will eventually melt."
		OverTime = "Heat naturally spreads out and, without an active heat source, will slowly dissipate on its own over time."
		Exchanger = "<good>TIP:</good> To remove hull heat, build <good>Heat Exchangers</good> connected to Radiators or Thermal Storages."
	}

	HeatManagement
	{
		Title = "Heat Management"
		Overview1 = "Some weapons and other ship parts, such as those in Overclock Mode, produce <orange>waste heat</orange> which will turn into dangerous <orange>hull heat</orange> if not managed."
		Overview2 = "To prevent this, connect them using <good>Heat Pipes</good> to other heat management parts. This creates a <good>thermal network</good>."
		Icons = "Locations where a part can be connected to a thermal network are indicated by orange 'port' icons. The orange lines show how everything in a thermal network is connected and thus can transfer heat."
		Batteries = "<good>Thermal Batteries</good> can receive and safely store large amounts of heat from other parts in the same thermal network."
		Radiators = "<good>Radiators</good> dissipate heat, pulling heat out of the connected thermal network and radiating it into space. Blocking a Radiator exhaust port will reduce the rate at which it can dissipate heat."
		Excess = "Any excess waste heat that cannot be safely stored or radiated will turn into dangerous <orange>hull heat</orange>, which will make your ship more vulnerable, start fires, and eventually melt."
		Exchangers = "And <good>Heat Exchangers</good> will absorb <orange>hull heat</orange> and put it into the connected thermal network to be safely stored or radiated away."
	}

	Overclocking
	{
		Title = "Overclocking"
		Overview1 = "Many parts can be <bad>overclocked</bad>, changing their functionality in powerful ways, but causing them to generate <orange>waste heat</orange>."
		Overview2 = "To see what overclocking a part will do, hover the mouse cursor over it to show the tooltip, and then press <btn id='Design.ToggleSecondaryTooltip'/>."
		HeatManagement = "<good>TIP:</good> Overclocked parts should be connected to a <good>thermal network</good> to safely store or radiate its waste heat, or else the waste heat will turn into dangerous <orange>hull heat</orange>."
	}

	Nebulas
	{
		Title = "Clouds & Storms"
		Nebulas = "As you explore each star system, you will sometimes encounter different types of <good>clouds</good> and <good>storms</good>. Flying into these areas may have both beneficial and detrimental effects."
		Example = "For example, ships inside a <good>gaseous cloud</good> (pictured) will be hidden to ships outside the cloud but will also have reduced sensor range."
	}

	Creative
	{
		Title = "Creative Mode"
		Unlimited = "Creative mode allows you to create and battle ships with unlimited <money>CREDITS</money>."
		NewShip = "To <good>design a new ship</good> from scratch, click the <white>New Ship</white> button."
		SaveShip = "To <good>save</good> your ship design, click the <img name='hamburger_up'/> button in the Ship Editor and then select <white>Save Ship Design</white>."
		AddShip = "To <good>add a saved ship</good> to the game, click the <white>Ship Library</white> button."
		Allegiance = "To <good>make ships battle</good>, click the little <img name='hamburger_up'/> button next to the ship's name, select <white>Allegiance</white>, and then pick a different player for each ship. "\
		             "Ships assigned to different players can be told to attack each other and will automatically fire when in range."
		PlayAs = "To change which player's ships you can <good>control</good>, click the <img name='hamburger_down'/> button near the top and select <white>Play As</white>."
	}

	DirectControl
	{
		Title = "Direct Control Mode"
		Camera = "While using Direct Control Mode, the camera will be locked on to your ship."
		Flight = "To fly your ship <good>forward or reverse</good>, press the <btn id='Game.DirectControlForward'/> or <btn id='Game.DirectControlReverse'/> keys."\
		         "\n\nTo <good>rotate left or right</good>, press the <btn id='Game.DirectControlRotateLeft'/> or <btn id='Game.DirectControlRotateRight'/> keys."\
		         "\n\nTo <good>\"strafe\" left or right</good>, press the <btn id='Game.DirectControlStrafeLeft'/> or <btn id='Game.DirectControlStrafeRight'/> keys."
		Weapons = "<good>Fire your weapons</good> by clicking the <white>mouse buttons</white>."\
		          "\n\nWeapons will <good>automatically target</good> any enemy ship near the mouse cursor. Press <btn id='Game.DirectControlLockTarget'/> to toggle target lock."
		Tip = "<good>TIP:</good> There are many options for customizing Direct Control Mode's flight and camera in the game settings."
	}

	Wanted
	{
		Title = "Becoming Wanted"
		Attacking = "Attacking ships or stations belonging to (or friends with) a faction will make you <bad>WANTED</bad>."
		Hunted = "While you are WANTED, that faction will <bad>hunt you</bad> near your last known location and attack you on sight."
		Evade = "<good>Evade detection</good> for long enough and they will give up."
	}

	Reputation
	{
		Title = "Faction Reputation"
		ReputationScore = "Each faction has its own opinion of you, represented by a <good>reputation score</good> that can be either positive or negative."
		Positive = "Completing missions for factions will improve your reputation. <good>Positive</good> reputation scores will reduce prices at their stations."
		Negative = "Likewise, attacking factions will reduce your reputation. <bad>Negative</bad> reputation scores will increase prices and make it harder to escape when wanted."
		View = "To view your reputation with each faction, open the <white>Career Log</white> and then click on the <white>Fame &amp; Reputation</white> tab."
	}
}

Lore
{
	Monolith
	{
		Title = "Monolith Cooperative"
		Lore1 = "The Monolith Cooperative is a massive mining, manufacturing, and transport company that dominates galactic trade and economics with near-monopolistic power."
		Lore2 = "Originally branded as the \"Armstrong Mining Cooperative\" in the pre-hyperdrive era, the company had the remarkable good fortune of being the first to discover what is now known as the \"Armstrong Monolith\" hidden deep within the Sol (Earth) system's asteroid belt. The Armstrong Monolith was the last remnant of an ancient civilization that made its home on the planet which, before its destruction, orbited between Mars and Jupiter. The monolith itself was a technological archive that, once decoded, was discovered to contain blueprints for hyperdrive technology and the ability to detect and use the vast network of hyperjump relays built by the civilization long ago. Although there is some debate, it is commonly assumed that the destruction of their planet was caused by a misuse of hyperjump technology similar in hubris to that which led humanity to destroy the whole Sol system. No biological remains of this civilization, nor any evidence of their physical form, have ever been found, leading to much speculation about whether they were truly alien or a precursor to humanity."
		Lore3 = "After the discovery of the Armstrong Monolith, it took only two years for the Armstrong Mining Cooperative to recreate rudimentary hyperdrive technology, and then only another five to make it robust enough for commercial use. Although at first the company successfully guarded the technology as the most important trade secret of all time, the fundamentals of hyperdrive technology eventually leaked a couple years later and quickly spread throughout the solar system. Even still, those couple years gave the company (now known as the Monolith Cooperative) enough of a head start to dominate its competitors and eventually become the largest industrial powerhouse in the history of humankind."
		Lore4 = "Although not overtly imperial in ambition, Monolith has gradually built one of the galaxy's largest military forces over the two-hundred years since the discovery of the Armstrong Monolith. At first this was out of necessity to defend its own transport routes and mining and manufacturing hubs, but as the might of its military hammer grew, well, as the saying goes, all its problems started looking like nails. Middle managers tasked with convincing reluctant colonies to pay exorbitant prices for life-sustaining necessities would often use their ostensibly \"defensive\" fleets to blockade competitors and coerce the colonies into signing unfair trade contracts. As the space-high prices of basic goods bankrupted the local governments, Monolith was only happy to step in and sell its own administrative and police services at a discount—in exchange for a hefty percentage tax on the colony's gross income, of course. Although claiming no actual territory, the Monolith Cooperative is now the de facto government of almost a quarter of the known galaxy."
		Lore5 = "The \"Cooperative\" part of its name comes from the fact that the Monolith Cooperative is and always has been fully employee-owned. No single person owns more than 0.1% of the company, and no shares of Monolith have ever been sold either publicly or privately. Instead, every full employee of Monolith (not including contractors) owns a very small percentage of the company (the exact amount depending on rank and length of employment) and as such is entitled to a proportional share of the company's profits in addition to their base salary. Since the company is ultimately subservient to its own employees, those who are lucky enough to be counted among them, from the middlest manager to the lowliest janitor, enjoy good pay, fair treatment, and a general quality of life far in excess of the galactic average, making the typical employee extremely loyal to the company. But due to their desire not to dilute their own shares, the employees of Monolith have mandated hiring standards so strict that only about 5% of the population under Monolith's governance are actual employees, many of whom only become so out of nepotism. Much of the remaining population lives in extreme poverty, and Monolith-governed colonies have by far the highest wealth inequality of anywhere in the galaxy."
	}

	Cabal
	{
		Title = "Cabal of Sol"
		Lore1 = "The Cabal of Sol is a religious and scientific organization that worshipped Sol (Earth's star) until its destruction fifty years ago and now endeavors to \"reincarnate\" its dead God through scientific research."
		Lore2 = "Although it is not known precisely when the Cabal was founded, it has existed in some form for at least several hundred years. Originally a secretive cult, it is now a massive, mainstream religion and powerful galactic nation-state. Its adherents believe that each star is, in effect, a God; creator of planets and moons and giver of the energies that sustain life. Although they believe that every star is a God, the Cabal of Sol specifically worships Earth's star Sol as the creator of not just Humanity but also the ancient civilization that created the hyperjump gates and left behind the Armstrong Monolith."
		Lore3 = "The Cabal of Sol is a highly-organized religion that claims more than a fifth of the known galaxy as its own territory, making it one of the largest galactic nation-states. Within Cabal territory, religion and government are inseparable. A hereditary council of twelve High Priests of Sol make the laws, and a complex hierarchy of priests and other clerics administer the functions of government with unusual strictness and harshness. But for those willing to live under the edicts of the Council, life can be good thanks to the extensive social services and a universal basic income provided by the Cabal. And many people from across the galaxy do indeed choose to brave the trip to Cabal space to take advantage, thanks to the Cabal's open immigration policy that welcomes all—as long as they profess a belief in Sol and renounce all other religions."
		Lore4 = "For the Cabal, religion and scientific research are not antithetical, but instead go hand-in-hand, with the desire to know more about the Gods motivating unprecedented scientific research into how stars are formed and function. Most of the galaxy's preeminent cosmic researchers are also devout worshippers of Sol and members of the Cabal. As a byproduct of this intense focus on scientific research into stars, the Cabal have become the galaxy's clear masters of energy manipulation technology."
		Lore5 = "Although unproven, rumors persist that Cabal scientists were directly involved in the accidental destruction of Sol and its star system. According to the rumors, Cabal scientists were working to develop hyperjump and shield technologies so advanced that a ship could jump directly into the core of a star, where its most elusive secrets would be revealed. But when this was attempted with Sol, according to the rumors, the result was not the hoped-for scientific and religious revelation, but the destruction of the entire Sol system, costing billions of lives and setting back human advancement by thousands of years. Any involvement in the destruction of Sol is, of course, denied by Cabal officials, but conspiracy theorists claim that their involvement could be proven if only the Cabal would open its vault of secret documents to the public—something which the Cabal has thus far refused to do."
		Lore6 = "Regardless of whether they were involved or not, their current motivation is very clear: The Cabal seeks to reignite Sol's dead core and reincarnate their dead God. Nearly all of the Cabal's formidable scientific might for the past fifty years has become singularly focused on this goal."
	}

	Imperium
	{
		Title = "Centauri Imperium"
		Lore1 = "The Centauri Imperium is a young but ruthlessly-ambitious military empire originating in the Centaurus Constellation."
		Lore2 = "The systems of the Centaurus Constellation were originally governed by the Terran Union headquartered on Earth, but with the destruction of the whole Sol system fifty years ago, the Centaurus Constellation found itself suddenly independent with a galactic power vacuum in need of filling. After a brief ideological civil war within the Centaurus Constellation, the new Centauri Imperium emerged triumphant and quickly expanded its domain into the surrounding systems by conquest and intimidation. In just fifty short years, the Centauri Imperium has become the most powerful military force in the galaxy, controlling nearly half of all known systems and poised to soon conquer the rest."
		Lore3 = "The Centauri Imperium is uniquely flat in its organizational structures, both civilian and military. As a true direct democracy, every citizen of the core Centaurus systems above the age of 12 EY is entitled to propose laws and vote on every piece of legislation, a process which is handled via faster-than-light communications and a distributed public blockchain. Even the most important decisions, such as whether to accept the terms of surrender of the latest conquered star system, can be made in minutes by instantly notifying the entire citizenry of an impending vote. As such, most Centauri citizens feel an extreme responsibility to stay informed of the various issues facing the Imperium, and civic engagement is very high. There is no single \"head of state\", and to the extent to which there is any concentration of power, it is in celebrities who are able to influence their followers to vote a particular way."
		Lore4 = "The Centauri military is only slightly more hierarchical than its civilian government. Because being able to make instant decisions during combat is critical, most ships do have a captain, but one that is elected by its crew and can be replaced by popular vote at any time. Each ship is an independent entity with the freedom to make its own tactical decisions, constrained only by the few rules of engagement mandated by the Imperium's citizens. (And those citizens have deemed that almost any means are acceptable as long as the ends bring further wealth and prosperity to the core Centaurus systems.) This decentralized \"almost anything goes\" approach makes the Imperium's military nimble and ruthless. Larger strategic objectives are coordinated using bounties authorized by the citizenry, such as a reward for forcing the surrender of a particular star system. In order to accomplish these larger strategic objectives, individual ships will often form ad-hoc fleets that will then disband once the objective is accomplished. In some cases, multiple fleets will form to compete for the same bounty, which is allowed and encouraged as a healthy aspect of the "military free market", though direct combat between Centauri ships or fleets is strictly forbidden and punishable by \"death by destruction bounty\". In cases where multiple ships or fleets lay claim to the same bounty, it is, as always, the Centauri citizenry who act as final arbiter."
		Lore5 = "Citizenship is only granted to those individuals who were either living within the core Centaurus systems when the Imperium was formed or are children whose parents are <i>both</i> Centauri citizens. The only exceptions must be approved by the whole citizenry, making naturalized citizens extremely rare. (Generally only individuals who have been of great service to the Imperium are given the honor.) As a result, the vast majority of subjects living outside the core systems are not Centauri citizens and thus do not enjoy any semblance of autonomy or self-governance. For all their talk of democracy and equality, the core systems impose a harsh double-standard on the conquered territories, ruling them with an iron fist."
	}

	Fringe
	{
		Title = "Fringe Systems Resistance"
		Lore1 = "The Fringe Systems Resistance is a loose conglomeration of independent star systems united only by the common desire to survive and remain independent."
		Lore2 = "The \"Fringe\" star systems are those that lie on the edge of the known galaxy or between the territories of the major factions. They are generally sparsely populated and have a low standard of living. While there is a strong code of honor among inhabitants of the Fringe, there is no common government or system of laws beyond the borders that can be enforced by each individual settlement or station. As such, the Fringe systems tend to attract a \"rough and ready\" type of personality, and piracy runs rampant."
		Lore3 = "There are no formal cooperation agreements between any of the Fringe systems, so the extent to which they can be called \"unified\" is based on a mutual hatred of the other major factions and an understanding that they can better defend their independence working (begrudgingly) together than apart. Despite this cooperation, the Fringe systems are no match for the full might of any of the major factions, and thus are fighting a doomed battle, losing their independence one-by-one."
	}

	Io
	{
		Title = "Great House Io"
		Lore1 = "Long before the discovery of the Armstrong Monolith and the destruction of Sol, as the cold war between Earth and Mars was heating up, many of the richest and noblest families of the Imperial Martian Matriarchy, known as The Great Houses, abandoned their sworn empress and fled their war-torn world to colonize the moons of the outer gas giants."
		Lore2 = "One such Great House, the Rodomonts, ran an industrial metallurgy and construction empire that spanned the Sol system and pioneered the modular starship-welding techniques still in use today. The Rodomonts, along with tens of thousands of their servants and most skilled employees, settled on Jupiter's moon Io, the most volcanically-active object in the Sol system, and formally restyled themselves as "The Great House Io". Using their metallurgical prowess, they tamed Io's volcanos and harnessed its heat for near limitless energy, all in less than a decade."
		Lore3 = "And then, for reasons only known by the House's top matriarchs, they decided to leave. Undertaking the largest and most ambitious construction and geo-engineering project in the history of humankind, they converted Io into a giant interstellar generation ship. Using Io's near-limitless internal heat to fuel the largest rocket thrusters ever built, Io escaped Jupiter's gravity and departed the Sol system. For hundreds of years, the Great House Io was never seen, presumed dead and lost forever."
		Lore4 = "That is, until the moon Io itself suddenly reappeared on the weakly-guarded outskirts of the Centauri Imperium, only now with a population in the millions thanks to an aggressive breeding program, and thousands of warships wielding advanced heat-based weaponry that were smelted from Io's molten iron core. Great House Io caught the Centauri Imperium by surprise and quickly conquered much of its rear territory, plus a handful of Fringe-aligned star systems, thus destabilizing the galaxy's delicate balance of power. Their mission, which was publicly broadcast throughout the known galaxy, is to unite Humanity under the rule of Io's matriarch in order to focus all of humanity's resources against a much larger threat they claim is looming on the horizon. But what that threat is, or what they saw in their hundreds of years traveling between the stars, they will not say."
	}
}

Tips
{
	// High-Priority
	Hamburgers
	{
		Title = "Hamburger Menus"
		Tip = "Cosmoteer has many tiny <img name='hamburger_up'/> and <img name='hamburger_down'/> menus. Keep an eye out for these! Clicking them will give you access to many advanced or \"hidden\" features."
		FunFact = "<gray>(Fun Fact: Game and app developers like to call these \"hamburger menus\".)</gray>"
	}
	RightClickMenus
	{
		Title = "Right-Click Menus"
		Tip1 = "Keep an eye out for when the mouse cursor shows this icon!"
		Tip2 = "This means that you can <btn id='General.UIAltClick'/> on this button or user interface element to access a popup menu containing advanced or \"hidden\" features. Many parts of the user interface have these hidden menus!"
	}
	Accessibility
	{
		Title = "Color-Blind & Accessibility Settings"
		Tip = "If you're having trouble distinguishing between friendly and enemy ship icons, you can change their colors in <good>Settings -> Accessibility</good>. There are also additional settings to make Cosmoteer easier on the eyes for visually-sensitive players."
	}
	QuickSave
	{
		Title = "Quick-Saves"
		Tip1 = "Press <btn id='Game.QuickSave'/> to quick-save your current game."
		Tip2 = "Press <btn id='Game.QuickLoad'/> to load the last saved game of any type."
		Tip3 = "By default, Cosmoteer will keep your last 25 quick-save files. Older quick-save files will be automatically deleted. You can change the number of quick-save files to keep in <good>Settings -> Auto-Save</good>."
	}
	AutoSave
	{
		Title = "Auto-Saves"
		Tip = "By default, Cosmoteer will auto-save your current game every 10 minutes and will keep your last 25 auto-save files. Older auto-save files will be automatically deleted. You can change duration and number of auto-save files in <good>Settings -> Auto-Save</good>."
	}
	Hotkeys
	{
		Title = "Hotkeys"
		Tip = "Many user interface buttons have \"hotkeys\" that you can press instead of clicking on the button. These hotkeys are almost always shown in the tooltip when hovering the mouse cursor over the button, and they can also be customized in <good>Settings -> Controls</good>."
	}
	RebindingControls
	{
		Title = "Rebinding Controls"
		Tip = "Almost all of the controls and hotkeys can be changed in <good>Settings -> Controls</good>."
	}
	Settings
	{
		Title = "Settings"
		Tip = "Cosmoteer is highly customizable and has <i>a lot</i> of settings. If you ever find yourself wishing you could change something about Cosmoteer, then take a look at the <good>Settings</good> -- there's a good chance there's already a setting for what you want!"
	}
	ChangingDifficulty
	{
		Title = "Changing Difficulty"
		Tip = "You can change the difficulty level in Career mode at any time while playing, not just when starting a new game. To change the difficulty, go to <good>Settings -> Current Game</good>."
	}
	AdvancedCareerMode
	{
		Title = "Advanced Career Mode Options"
		Tip = "Career Mode has a handful of advanced options you can change to tailor the game to your preferences, such as making ship construction instant or revealing the whole star system. You can turn these on by clicking <good>Advanced Game Options</good> when starting a new Career game or in <good>Settings -> Current Game -> Advanced Game Options</good> while playing."
	}
	GameSpeedFramerate
	{
		Title = "Game Speed & Framerate"
		Tip = "Increasing the game speed to 8x means that your CPU has to do 8 times as much work as 1x speed. This can cause poor framerate (FPS), especially in the late-game. Consider reducing game speed to improve framerate."
	}
	Feedback
	{
		Title = "Sending Feedback"
		Tip = "We'd love to get your feedback! Press <btn id='General.SubmitFeedback'/> at any time to send us your ideas, complaints, bug reports, or any kind of feedback. Thank you!"
	}

	// General Ship UI
	AdvancedCommands
	{
		Title = "Advanced Ship Commands"
		Tip = "If you can't see these advanced ship command buttons, then you can enable them at <good>Settings -> Gameplay -> Show Advanced Ship Commands</good>"
	}
	CtrlSelectsParts
	{
		Title = "Require Ctrl To Select Parts"
		Tip = "If you can't select individual weapons and other ship parts simply by clicking on them, then you need to either hold <btn id='Game.SelectParts'/> or disable the <good>Settings -> Gameplay -> Require Ctrl To Select Parts</good> setting."
	}
	SelectSameType
	{
		Title = "Selecting Same-Typed Parts"
		Tip = "You can <white>double-click</white> to select all ship parts of the same type. For directional parts such as weapons, thrusters, and shields, only the parts facing the same direction will be selected. <white>Triple-click</white> to select all regardless of direction."
	}
	CtrlTargeting
	{
		Title = "Ctrl Targeting"
		Tip1 = "You can hold <btn id='Game.SelectParts'/> to target your weapons on enemy ships without having to attack them first."
		Tip2 = "You can also hold <btn id='Game.SelectParts'/> to force-target your weapons on friendly ships."
	}
	AttackDefaults
	{
		Title = "Setting Attack Defaults"
		Tip = "Are you tired of having to set your ship's distance and rotation every time you attack an enemy? Open the <img name='hamburger_up'/> menu next to your ship's name and click <good>Save Attack Defaults</good>. Your current distance, rotation, and angle of attack will be remembered the next time you attack something."
	}
	ControlGroups
	{
		Title = "Control Groups"
		Tip1 = "You can put one or more of your ships into a \"control group\" by selecting them and then pressing <white>Ctrl + F1-F8</white>. Then you can select all ships in that group by pressing <white>F1-F8</white>."
		Tip2 = "Likewise, you can put one or more individual weapons or other ship parts into control groups by selecting them and then pressing <white>Ctrl + 0-9</white>. Then you can select all parts in that group by pressing <white>0-9</white>."
	}
	CollisionAvoidance
	{
		Title = "Collision Avoidance"
		Tip = "Ships will usually try to navigate around large obstacles to avoid colliding with them. If you don't like this, then you can hold <btn id='Game.InvertCollisionAvoidance'/> while giving a move order to disable collision avoidance, or stop it more permanently by turning off <good>Settings -> Gameplay -> Ship Commands -> Enable Collision Avoidance</good>."
	}
	WorldRelativeAngles
	{
		Title = "Grid Relative Attack/Follow Angles"
		Tip = "Normally when you attack or follow another ship at a specific angle, that angle will change as the other ship rotates. Hold <btn id='Game.WorldRelativeFollowAngle'/> when issuing the attack or follow order to prevent this."
	}
	DirectControlBindings
	{
		Title = "Direct Control Weapon Bindings"
		Tip1 = "For Direct Control Mode, you can customize what mouse button is used to fire each weapon. Select the weapon(s), open its <img name='hamburger_up'/> menu, and select <white>Direct Control Binding</white>."
		Tip2 = "You can also set weapons to remain <white>A.I. Controlled</white> even when using Direct Control Mode."
	}
	DirectControlSettings
	{
		Title = "Direct Control Settings"
		Tip = "Direct Control Mode has many settings that you can change to tailor the controls and camera to your preference. You can change these in <good>Settings -> Gameplay -> Direct Control Mode</good> and <good>Settings -> Camera -> Direct Control Mode</good>."
	}
	DirectControlSuppress
	{
		Title = "Suppressing Direct Control Mode"
		Tip = "When in Direct Control Mode, you can <i>temporarily</i> disable it by holding <btn id='Game.SelectParts'/>, allowing you to command the ship and control your view normally. Releasing <btn id='Game.SelectParts'/> will then return you to Direct Control Mode."
	}

	// Camera
	DisableEdgePan
	{
		Title = "Camera Edge Pan"
		Tip = "Do you get annoyed when the mouse cursor accidentally touches the edges of the screen and causes the view to move? If so, you can turn that off at <good>Settings -> Camera -> Pan &amp; Rotate -> Edge Pan</good>."
	}
	MidpointFocus
	{
		Title = "Midpoint Focus Icon"
		Tip = "After attacking an enemy ship, you can click the \"eye\" icon to focus your view on the point halfway between your ship and its target."
	}
	RotateCamera
	{
		Title = "Camera Rotation"
		Tip1 = "You can press <btn id='View.RotateLeft'/> and <btn id='View.RotateRight'/> to rotate your view."
		Tip2 = "To reset your view rotation back to the default, press <btn id='View.ResetRotation'/> or click the red \"Galactic North\" arrow on the minimap."
	}
	RotationFocus
	{
		Title = "Focus & Match Rotation"
		Tip1 = "You probably already know that you can press <btn id='View.FocusSelected'/> to focus your view on your ship."
		TIp2 = "You can also press <btn id='View.RotationFocusSelected'/> to focus on your ship <b>and</b> match its rotation."
	}
	PipSettings
	{
		Title = "Picture-In-Picture Settings"
		Tip = "You can customize when and what the \"Picture-In-Picture\" view in the top-right displays by going to <good>Settings -> Camera -> Picture-In-Picture</good>."
	}

	// General UI
	WhenEnemySpotted
	{
		Title = "When Enemy Spotted"
		Tip = "Are you annoyed by the game slowing down whenever an enemy is detected? You can turn that off or pick a different game speed at <good>Settings -> Gameplay -> Informational Overlays -> When Enemy Spotted</good>."
	}
	ScreenshotsAndGifs
	{
		Title = "Screenshots & GIFs"
		Tip1 = "You can take a screenshot anytime by pressing <btn id='General.TakeScreenshot'/>."
		Tip2 = "You can also record and save recent gameplay as an animated GIF by pressing <btn id='General.CaptureGif'/>, but you'll need to turn that on first in <good>Settings -> GIF Recorder</good>."
	}
	DisableUI
	{
		Title = "Disabling the U.I."
		Tip = "Do you think your screenshots and GIFs would be prettier without the user interface? Press <btn id='Game.ToggleUI'/> to hide it. Press again to show un-hide it."
	}
	AreYouSure
	{
		Title = "Are You Sure?"
		Tip = "Many of the <i>\"Are you sure you want to... ?\"</i> style confirmation prompts can be skipped by holding <btn id='General.SuppressConfirmation'/>."
	}

	// Missions
	MissionsHUD
	{
		Title = "Missions HUD"
		Tip1 = "By default, only the 3 nearest missions will be displayed in the top-left of your screen. You can change that number at <good>Settings -> Gameplay -> Informational Overlays -> Show Nearby Missions On HUD</good>."
		Tip2 = "You can also mark a mission as a \"favorite\" by <white>right-clicking</white> on it or pressing the \"Favorite\" button in the Career Log. This will cause the mission to always be displayed even if other missions are closer."
	}
	ObjectiveFocus
	{
		Title = "Focusing Objectives"
		Tip = "You can click on most mission objectives to focus your view on the location where you'll need to fly to accomplish that objective."
	}
	FameLimit
	{
		Title = "Fame Limit"
		Tip = "Most missions have a \"fame limit\". If you already have more <fame>Fame</fame> than the limit, the mission won't give you any more fame. Complete higher-level missions to continue earning fame."
	}

	// Ship Editor
	SavingShips
	{
		Title = "Saving Ships"
		Tip = "Your ship designs can be saved so that they can be reused in other game modes such as Creative Mode and multiplayer. To save your ship design, open the <img name='hamburger_up'/> menu next to your ship name or in the Ship Editor and then select <white>Save Ship Design</white>."
	}
	SubFolders
	{
		Title = "Ship Sub-Folders"
		Tip = "You can organize your saved ship designs into sub-folders just like you can files and folders on your computer. To create a sub-folder, <btn id='General.UIAltClick'/> on \"My Ships\" in your Ship Library and select <white>New Folder</white>. Then simply drag-and-drop your ship designs into the new folder."
	}
	SavedShipFiles
	{
		Title = "Saved Ship Files"
		Tip1 = "Ship designs are actually saved as regular PNG image files but with the extension <fame_color>.ship.png</fame_color>. You can share these files with your friends or on the Cosmoteer Discord just like you can any image file. These files are stored on your computer in a folder called \"Saved Ships\", which you can access by clicking the <img name='hamburger_down'/> menu in the Ship Library and then selecting <white>Open Folder</white>."
		Tip2 = "You can load and play with anyone else's saved ship design simply by copying their ship file into your own Ship Library. As long as the image hasn't been modified in any way, it should instantly appear in your Ship Library and be fully playable. And if you're playing Cosmoteer in \"Resizable Window\" mode, you can just drag-and-drop the image directly into your Ship Library or an active Creative Mode game."
	}
	BlueprintMode
	{
		Title = "Blueprint Mode"
		Tip = "You can use \"Blueprint Mode\" to make temporary, illegal, or unaffordable changes to your ship's design before actually committing to those changes. Click the <white>Blueprint Mode</white> button in the lower-left of the Ship Editor to enable Blueprint Mode."
	}
	FlightDirection
	{
		Title = "Flight Direction"
		Tip = "By default, your ships will always fly as if \"up\" in the Ship Editor is the forward direction. You can change which direction is \"forward\" by opening the <img name='hamburger_up'/> menu next to your ship name or by clicking the little up arrow on the right side of the Ship Editor."
	}
	MirrorModeSettings
	{
		Title = "Mirror Mode Settings"
		Tip = "You probably already know that you can enable \"Mirror Mode\" to make symmetrical changes to your ship's design. You can also <btn id='General.UIAltClick'/> on the Mirror Mode button to change the direction and number of symmetry lines."
	}
	SymmetryLines
	{
		Title = "Moving Symmetry Lines"
		Tip = "When Mirror Mode is enabled, you can move the symmetry lines by clicking and dragging these green handles."
	}
	ForceStartConstruction
	{
		Title = "Force Start Construction"
		Tip = "Normally you can't begin construction if you don't have enough resources to finish. However, you can hold <btn id='Design.ConfirmPartialBuild'/> to force construction to begin anyway. Your crew won't be able to finish but they'll do as much as they can."
	}
	RecommendationBars
	{
		Title = "Recommendation Bars"
		Tip = "The bars showing <b>crew</b> and <b>power</b> on the right side of the Ship Editor are only <i>recommendations</i> for new players. Optimally-designed ships may not require as much crew or power. You can turn these bars off at <good>Settings -> Ship Editor -> Show Recommendation Bars</good>."
	}
	DeleteShortcut
	{
		Title = "Removing Parts & Decals"
		Tip = "In the Ship Editor or Paint Editor, you can hold <btn id='Design.EraseCursorMode'/> to temporarily switch to deletion mode."
	}
	DisableAutoDoors
	{
		Title = "Disabling Auto-Doors"
		Tip = "When adding new rooms to your ship, doors will be automatically added by default. If you don't like this, then you can hold <btn id='Design.NoAutoDoors'/> to temporarily stop them from being added, or you can turn off the feature altogether at <good>Settings -> Ship Editor -> Automatically Add Doors</good>."
	}
	FillDoors
	{
		Title = "Filling All Doors"
		Tip = "Do you want a door in every possible location? Hold <btn id='Design.FillAllDoors'/> while adding a door to add doors <i>everywhere</i>."
	}
	DeleteDoors
	{
		Title = "Deleting Doors"
		Tip = "If you want to delete many doors at once, use the Selection Tool to select all of the parts whose doors you want to delete, and then press <btn id='Design.DeleteDoors'/>."
	}
	PartBrushes
	{
		Title = "Part Brushes"
		Tip = "Most 1x1 sized parts can be used with a variety of different \"brush\" sizes and shapes. Click the brush selection button when available to see all the options."
	}
	LoadBlueprints
	{
		Title = "Loading Blueprints"
		Tip1 = "You can load the blueprints of another saved ship design into your current ship. In the Ship Editor, open the <img name='hamburger_up'/> menu and then click either:"
		Tip2 = "<b>Load Ship (Replace Existing)</b> - This will completely replace your ship's existing blueprints with those of the saved ship design."
		Tip3 = "<b>Load Ship (Paste Into Existing)</b> - This will add the saved ship's blueprints into your existing ship at a location of your choice."
	}
	LoadShapeFromPNG
	{
		Title = "Load Shape From PNG"
		Tip1 = "You can use external art programs such as MS Paint, Paint.NET, Gimp, or Photoshop to create the basic shape outlines for your ships..."
		Tip2 = "1. First, use any external art program of your choice to save a <b>white-on-black</b> PNG image file that represents the general shape of your ship. White pixels will be interpreted as corridor tiles, and black pixels will be interpreted as empty space."
		Tip3 = "2. Then in the Ship Editor, open the <img name='hamburger_up'/> menu, and select <white>Load Shape From PNG</white>. Select the PNG image file that you saved."
		Tip4 = "3. Your ship's current blueprints will be replaced with the blueprints created your PNG image file. Finish your ship by adding weapons, thrusters, defenses, and other parts as you see fit."
	}
	EditShipInfo
	{
		Title = "Editing Ship Info"
		Tip = "You can edit your ship's name, designer (author), description, and lore. Open the <img name='hamburger_up'/> menu next to your ship's name and select <white>Edit Ship Name/Info</white>. <gray>(Or you can just click on the name itself!)</gray>"
	}
	Favorites
	{
		Title = "Favorite Parts & Decals"
		Tip1 = "You can save up to three different custom sets of \"favorite\" ship parts or paint decals. <btn id='General.UIAltClick'/> on the part or decal to add it to or remove it from any of those sets."
		Tip2 = "You can also <btn id='General.UIFocusClick'/> on a part or decal to quickly favorite or un-favorite it."
	}
	PartRows
	{
		Title = "Ship Editor Rows"
		Tip = "You can increase the number of part types visible in the Ship Editor by changing <good>Settings -> Ship Editor -> Rows Of Parts</good>."
	}

	// Paint Editor
	DecalLayers
	{
		Title = "Decal Layers"
		Tip = "You can click on the \"eye\" icon to hide or un-hide decal layers. Drag-and-drop decal layers to change their order."
	}
	LoadPaint
	{
		Title = "Loading Paint"
		Tip = "You can load the paint/decal design of another saved ship into your current ship. In the Paint Editor, open the <img name='hamburger_up'/> menu and then click <white>Load Paint Design</white>."
	}
	PaintSchemes
	{
		Title = "Paint Schemes"
		Tip1 = "\"Paint Schemes\" are saved sets of paint colors and textures that can be shared between ships."
		Tip2 = "To save a ship's current colors and texture, open the <img name='hamburger_up'/> menu in the Paint Editor and then select <white>Save Paint Scheme</white>. To load that paint scheme on a different ship, open its <img name='hamburger_up'/> menu and select <white>Load Paint Scheme</white>."
	}

	// Crew
	CrewCustomization
	{
		Title = "Crew Customization"
		Tip = "The names and appearances of all your crew can be customized! Open the Crew Roster and then <white>double-click</white> on the crew member who you wish to customize."
	}
	CrewFavorite
	{
		Title = "Favorite Crew"
		Tip = "Do you care about some of your crew more than others? <white>Right-click</white> on them in the Crew Roster and mark them as a \"favorite\". That way you can always tell where they are!"
	}
	RoleOrder
	{
		Title = "Crew Role Order"
		Tip = "You can change the order in which your crew roles are listed by dragging-and-dropping them. This has no effect on how your crew function but can be useful for organization."
	}
	SharingRoles
	{
		Title = "Sharing Roles"
		Tip1 = "Once you have perfected your ship's crew roles, you may want to use those same roles with your other ships. There are several ways of doing that:"
		Tip2 = "1. You can load the roles from any saved ship design by opening the <img name='hamburger_up'/> menu in the Crew Management screen and selecting <white>Load Ship Roles</white>."
		Tip3 = "2. From that same <img name='hamburger_up'/> menu, you can also <white>Copy Roles</white> from one ship and then <white>Paste Roles</white> into another ship."
		Tip4 = "3. And lastly, you can select <white>Save As My Default Roles</white>. Any new ship designs you start will use those roles by default."
	}
	HiringPriority
	{
		Title = "Hiring Priority"
		Tip1 = "Every crew role has a \"Hiring Priority\" between <bad>1</bad> and <good>10</good>. When you hire or transfer new crew to your ship, they will automatically join the role with the highest Hiring Priority that has room."
		Tip2 = "If you enable the <white>Auto-Fill From Lower Priority Roles</white> option, then any empty crew slots will be automatically filled by transferring crew from roles with a lower Hiring Priority."
	}
	CrewResourceTransfer
	{
		Title = "Crew & Resource Transfer"
		Tip = "You can transfer crew and resources between your ships. Click the <img name='hamburger_up'/> menu next to your ship's name (or in the Crew or Resource Management screens) and then select <white>Transfer Crew / Resources</white>."
	}

	// Resources
	ResourceCollectionTypes
	{
		Title = "Resource Collection Types"
		Tip = "Do you already have enough of a certain kind of resource? <btn id='General.UIAltClick'/> on the Gather/Salvage/Mine button and unselect the resources that you no longer want. Your crew will no longer gather, salvage, or mine those types of resources."
	}
	ResourceLimits
	{
		Title = "Resource Limits"
		Tip1 = "You can limit how many resources your ship will store of any specific type. <btn id='General.UIAltClick'/> on the Gather/Salvage/Mine button and select <white>Resource Desires &amp; Limits</white>."
		Tip2 = "When a limit has been set for a specific kind of resource, your crew won't gather, your factories won't produce, and you won't be able to buy, more than that limit."
	}
	MovingResources
	{
		Title = "Moving Resources"
		Tip = "When using the Resource Management screen to move resources, you can hold <btn id='Resources.Move1'/> to pick up or drop 1 resource at a time instead of the whole stack. Hold <btn id='Resources.Move5'/> for 5 at a time."
	}
	ResourceEjection
	{
		Title = "Resource Ejection"
		Tip = "To eject all or a specific number of resources, <btn id='General.UIAltClick'/> on its button along the bottom of the Resource Management screen and choose one of the <white>Eject</white> options."
	}

	// Trade
	Trade5x
	{
		Title = "Trading 5x"
		Tip = "While trading or transferring resources, you can hold <btn id='Resources.Transfer5'/> to move 5 times as many resources per click."
	}
	TradeAmount
	{
		Title = "Trading Exact Amounts"
		Tip1 = "When trading or transferring resources, you can click on the number and type in the exact amount you wish to buy, sell, or transfer. A positive number means that you want to buy (or transfer left to right). A negative number means that you want to sell (or transfer from right to left)."
		Tip2 = "You can also type in the total amount the you want stored on your ship, and the amount that you need to buy, sell, or transfer will be automatically calculated."
	}
	TradeSurplusNeeded
	{
		Title = "Sell Surplus / Buy Needed"
		Tip1 = "When trading, you can sell your excess resources above a \"desired\" amount by <white>right-clicking</white> on a resource and choosing <white>Sell Surplus</white>. Or you can buy what you need to reach the \"desired\" amount by choosing <white>Buy Needed</white>. Open the <img name='hamburger_up'/> menu to Sell Excess or Buy Needed for all resources at once."
	}

	// Parts
	EngineRoomDistribution
	{
		Title = "Engine Room Power Distribution"
		Tip = "Engine Rooms can receive and distribute power batteries for any connected thrusters, meaning your crew don't actually need to be able to reach your thrusters as long as your thrusters are connected to an engine room that <i>can</i> be reached."
	}
	LauncherTypes
	{
		Title = "Launcher Types"
		Tip = "You can change what type of missile or mine a Launcher shoots at any time, including during battle. Use this to surprise your enemy with a few unexpected nukes!"
	}

	// Creative Mode
	DesigningAsteroids
	{
		Title = "Designing Asteroids"
		Tip = "In Creative Mode, you can design asteroids just like you can design ships. <btn id='General.UIAltClick'/> on the New Ship button and select Asteroid or Megaroid. <gray>(Megaroids are really big asteroids.)</gray>"
	}
	TeleportShip
	{
		Title = "Teleporting Ships"
		Tip = "In Creative Mode, you can press <btn id='CreativeMode.MoveShip'/> to instantly teleport the selected ship to its destination."
	}
	SpawnNotReady
	{
		Title = "Spawn Without Ammo/Power"
		Tip = "In Creative Mode, if you hold <btn id='CreativeMode.SpawnNotReady'/> while spawning in a ship then it will spawn without any power, munitions, or resources."
	}
	BattleHelper
	{
		Title = "Battle Helper"
		Tip = "In Creative Mode, you can use the Battle Helper to setup and run battles between two opposing fleets of ships. You can access the Battle Helper from the <img name='hamburger_down'/> menu."
	}

	// Multiplayer
	TransferringShipsMoney
	{
		Title = "Transferring Ships & Money"
		Tip1 = "When playing multiplayer Career mode, you can transfer your ships to any of the other players. Click the <img name='hamburger_up'/> menu next to your ship's name and then select <white>Transfer Ship Control To</white>."
		Tip2 = "You can also give <money_color><img name='money' colored='true'/></money_color> credits to the other players. <btn id='General.UIAltClick'/> on your <money_color><img name='money' colored='true'/></money_color> credits display in the top-right and then select <white>Transfer Credits To</white>."
	}
	Chatting
	{
		Title = "Multiplayer Chat"
		Tip = "In multiplayer, you can send text chat messages to the other players by pressing <btn id='Game.Chat'/>."
	}
	Scoreboard
	{
		Title = "Multiplayer Scoreboard"
		Tip = "In PvP multiplayer, press <btn id='Multiplayer.ShowScoreboard'/> to display the current scoreboard."
	}
	DisplayName
	{
		Title = "Multiplayer Display Name"
		Tip = "By default, you will appear in multiplayer using your Steam account name, but you can change your display name at <good>Settings -> Misc -> Multiplayer -> Display Name</good>."
	}

	// Misc
	ModAutoDisable
	{
		Title = "Auto-Disabling Mods"
		Tip = "When updating Cosmoteer, any mods you have installed <b>may</b> be automatically disabled if they are not known to be compatible with the new Cosmoteer update. If you don't want mods to be automatically disabled, then turn off <good>Settings -> Misc -> Disable Mods When Updating</good>."
	}
	PostShaders
	{
		Title = "Post Shaders"
		Tip1 = "Do you wish Cosmoteer looked like a black-and-white 1950s sci-fi movie? If so, then choose \"It Came From Outer Space\" in <good>Settings -> Graphics -> Preferences -> Post Shader</good>."
		Tip2 = "There are also several other styles of fun \"post shaders\" for you to try out!"
	}
	Discord
	{
		Title = "Discord"
		Tip = "Cosmoteer has a vibrant and welcoming community on Discord! To join, click <img name='hamburger_up'/>MORE on the title screen and then select <good>Community -> Discord</good>."
	}
	ReleaseCandidates
	{
		Title = "Release Candidates"
		Tip1 = "You can help test pre-release Cosmoteer updates by switching to the \"unstable\" beta branch in Cosmoteer's Steam properties."
		Tip2 = "<bad>WARNING:</bad> These \"release candidates\" may be more buggy than the official updates. Save often!"
	}
}